# FireFly QuestLab 最小降级档的宿主进程配置。
#
# 只用于本地开发。这里的 Token 与 HMAC Secret 是公开的开发占位值，
# 任何非本机环境都必须覆盖；进程环境变量优先级高于本文件，可直接用
# $env:RETRIEVAL_API_TOKEN = "..." 覆盖。
#
# 数据库指向 questlab-min.yml 发布的 127.0.0.1:55433，与 lite/dev 档的 55432 隔离。
DATABASE_URL=postgresql://questlab:questlab@127.0.0.1:55433/questlab

# Retrieval API：只监听回环地址，端口与 lite/dev 档的 53200 隔离。
RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=53201
RETRIEVAL_API_TOKEN=questlab-min-retrieval-token
RETRIEVAL_IDENTITY_HMAC_SECRET=questlab-min-identity-secret-32-bytes-minimum
RETRIEVAL_LOGICAL_NAME=memory.hybrid

# 只读 Admin API：端口与 lite/dev 档的 3100 隔离。
# Admin API 返回完整 Run 轨迹与成本账本，因此默认要求 Bearer Token。
# 下面是公开的本机开发占位值，任何非本机环境都必须覆盖。
ADMIN_PORT=3101
ADMIN_API_TOKEN=questlab-min-admin-token-dev-only

# 显式降级：Embedding、Reranker 全部关闭。
# 关闭时 Retrieval 只宣告 PostgreSQL FTS 词法检索，不宣告 vector / rerank 阶段。
# 需要开启时按 ADR 0036 / ADR 0041 补齐完整变量组，缺项会 fail closed。
