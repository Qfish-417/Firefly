# FireFly QuestLab 远程模型档（最小降级档的模型扩展，不替代 Stub 档）
#
# 复制为 questlab-remote-model.env 后使用；实际文件被 .gitignore 排除。
#   cp infra/compose/questlab-remote-model.env.example infra/compose/questlab-remote-model.env
#
# 前提：vLLM 端点必须以 127.0.0.1 出现。
#
# Model Gateway 强制 HTTPS，只有主机名字面为 localhost / 127.0.0.1 / ::1 时才允许 HTTP，
# 且必须显式声明 allow_insecure_localhost。远程 IP 即使能直连也会被拒绝注册，
# 因为模型请求携带提示词与学员数据，明文跨网传输不可接受。
#
# 若 vLLM 在远程主机，先建 SSH 隧道把端口映射到本机回环：
#   ssh -N -L 11401:127.0.0.1:11401 -L 11400:127.0.0.1:11400 <user>@<host>
# 长期部署应改为 nginx 终止 TLS，然后把 base_url 换成 https://<域名>/... 并删掉
# allow_insecure_localhost。

# 数据库使用本档自己的 PostgreSQL 容器（端口 55473，与 min/lite/dev 的 55433/55432 隔离；
# 不用 55434 是因为它落在 Windows 的 TCP 保留区间 55373-55472，Docker 无法绑定）。
# 模型调用记录写入同一套审计账本结构。
DATABASE_URL=postgresql://questlab:questlab@127.0.0.1:55473/questlab

# 生成模型：vLLM 的 OpenAI Chat Completions 兼容端点。
#
# model.id 必须与 /v1/models 返回的 id 完全一致，否则 vLLM 返回 404。
# 自建模型无按 token 计费，成本填 0：审计账本仍记录 token 数，
# cache_* 未声明时回退到 input_cost_per_million（这里是 0），不会虚报花费。
# context_window 按 /v1/models 的 max_model_len 填写。
# max_output_tokens 故意保守：单次生成越长，占用租约与 Loop Sentinel 超时窗口越久。
# api_key_env 已省略——vLLM 未启用 --api-key 时不需要凭据；若启用则加回该字段并指向环境变量名。
#
# request_parameters 是发给该 provider 的额外请求字段，用于 pi-ai 未建模的厂商扩展。
# reasoning_effort=none 关闭 Qwen3.5 的思考输出：不关的话它会把
# "Thinking Process:..." 直接写进 message.content，导致要求严格 JSON 的 Agent 解析失败
# （实测原文以 Thinking Process 开头，JSON.parse 抛错）。
# Gateway 已设置的字段优先，所以这里无法篡改调用本身的框定。
FIREFLY_MODEL_PROVIDERS=[{"id":"vllm-remote","name":"Remote vLLM (via tunnel)","base_url":"http://127.0.0.1:11401/v1","api":"openai-completions","allow_insecure_localhost":true,"models":[{"id":"Qwen3.5-4B","name":"Qwen3.5 4B (remote vLLM)","context_window":262144,"max_output_tokens":4096,"input_cost_per_million":0,"output_cost_per_million":0}],"request_parameters":{"reasoning_effort":"none"}}]

# 三个业务 Agent 的 workload 路由。workload 名称由各 Agent 代码固定声明，不能改写：
#   learning-director.mission-plan / learning-scientist.analyze / experience-engineer.patch
FIREFLY_MODEL_ROUTES={"learning-director.mission-plan":[{"provider":"vllm-remote","model":"Qwen3.5-4B"}],"learning-scientist.analyze":[{"provider":"vllm-remote","model":"Qwen3.5-4B"}],"experience-engineer.patch":[{"provider":"vllm-remote","model":"Qwen3.5-4B"}]}

# 单次 Run 的预算上限。三者都必须为正数（0 会被拒绝：上限为 0 等于禁止一切调用）。
#
# 自建模型的单价配成 0，所以 cost 实际不会增长，这里的 1 只是一个不会触发的形式上限；
# 真正起护栏作用的是 token 与时长。它们防的是跑飞，不是计费。
QUESTLAB_MODEL_MAX_COST_USD=1
QUESTLAB_MODEL_MAX_TOKENS=200000
QUESTLAB_MODEL_MAX_DURATION_SEC=1800

# 三个 Agent 单次调用的输出上限下界。
#
# Agent 代码里的默认值（1000 / 1200 / 8000）是按"只输出答案"的模型定的。
# Qwen3.5 是推理模型，思考过程同样计入 output_tokens——实测默认 1000 全被思考吃掉，
# 一个可解析的 JSON 都没产出，直接以 finish_reason=length 失败。
#
# Gateway 仍会用模型描述、上下文窗口与剩余预算再夹一次，所以这个值只能降低实际生效额度，
# 不可能突破路由允许的范围。
FIREFLY_AGENT_MAX_OUTPUT_TOKENS=8192

# ---------------------------------------------------------------------------
# 以下为向量检索（可选）。四个 EMBEDDING_* 必须同时提供，缺一个即报错。
# 仅 npm run remote:retrieval 需要；三 Agent 闭环本身不读这些值。
# ---------------------------------------------------------------------------

# 注意路径：这里要写到 /v1/embeddings，与生成端点的 /v1 结尾不同。
EMBEDDING_ENDPOINT=http://127.0.0.1:11400/v1/embeddings
EMBEDDING_ALLOW_INSECURE_LOCALHOST=true
EMBEDDING_MODEL=Qwen3-VL-Embedding-2B

# 不可变快照标识。它随 memory_chunk 一起落库，用于区分"同名模型的不同版本"。
# 换模型或换权重时必须改这个值，否则新旧向量会混在同一个逻辑索引里而无人察觉。
EMBEDDING_MODEL_SNAPSHOT=Qwen3-VL-Embedding-2B@2026-08

# 必须与模型实际输出维度一致（实测 Qwen3-VL-Embedding-2B 为 2048）。
# 填错不会报错，但会写进 memory_chunk.embedding_dimensions 并参与 ::vector(N) 转换
# 与路由过滤，结果是检索不到任何数据。
#
# 2048 维的已知限制：pgvector 的 vector 类型 HNSW/ivfflat 索引上限为 2000 维
# （实测 "column cannot have more than 2000 dimensions"），因此向量检索只能走
# 全表扫描。10 万 chunk 以内 p50 约 140ms 可接受；超过则需要 halfvec 索引方案
# （halfvec 上限 4000 维），详见 docs/performance-baseline.md。
EMBEDDING_DIMENSIONS=2048

# 是否把 dimensions 作为请求参数发给 provider。默认 false。
# 只有支持 Matryoshka 降维的模型接受该参数，其余模型会整个请求报错——
# 实测 vLLM 0.27.0 + Qwen3-VL-Embedding-2B 返回：
#   HTTP 400 Model does not support Matryoshka embeddings; dimensions must be unset
# 关闭它不影响校验：返回的维度始终会与 EMBEDDING_DIMENSIONS 比对，不一致即报错。
EMBEDDING_SEND_DIMENSIONS=false

# Retrieval API 与 Admin API。Token 无默认值，缺失即拒绝启动。
# 请替换为强随机值：openssl rand -hex 32
RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=3201
RETRIEVAL_LOGICAL_NAME=memory.hybrid
RETRIEVAL_API_TOKEN=replace-me-with-openssl-rand-hex-32
RETRIEVAL_IDENTITY_HMAC_SECRET=replace-me-with-at-least-32-characters
ADMIN_PORT=3102
ADMIN_API_TOKEN=replace-me-with-at-least-16-chars
