# FireFly QuestLab SotaModel 模型档配置（最小降级档的模型扩展，不替代 Stub 档）
#
# 本文件只包含非敏感配置：Provider 身份、固定 HTTPS endpoint、模型元数据与路由。
# API Key 绝不写在这里，只通过环境变量名 SOTAMODEL_API_KEY 间接引用。
#
# 数据库沿用最小降级档的 127.0.0.1:55433，模型调用记录写入同一套审计账本。
DATABASE_URL=postgresql://questlab:questlab@127.0.0.1:55433/questlab

# SotaModel 是 OpenAI Chat Completions 兼容中转，请求路径为 /chat/completions。
# base_url 必须是 HTTPS 且不含凭据、查询串或片段，否则 Provider 注册会被拒绝。
#
# 价格与上下文为待核实的保守占位值：
#   input_cost_per_million / output_cost_per_million 需要按 SotaModel 控制台实际单价替换，
#   否则审计账本里的 cost_microusd 只反映这里填写的假设值，不是真实账单。
#   context_window / max_output_tokens 同理，宁可偏小也不要虚高。
FIREFLY_MODEL_PROVIDERS=[{"id":"sotamodel","name":"SotaModel","base_url":"https://www.sotamodel.net/v1","api":"openai-completions","api_key_env":"SOTAMODEL_API_KEY","models":[{"id":"claude-opus-5-max","name":"Claude Opus 5 Max (SotaModel relay)","context_window":200000,"max_output_tokens":8192,"input_cost_per_million":15,"output_cost_per_million":75,"reasoning":true}]}]

# 三个业务 Agent 的 workload 路由。workload 名称由各 Agent 代码固定声明，不能随意改写。
FIREFLY_MODEL_ROUTES={"learning-director.mission-plan":[{"provider":"sotamodel","model":"claude-opus-5-max"}],"learning-scientist.analyze":[{"provider":"sotamodel","model":"claude-opus-5-max"}],"experience-engineer.patch":[{"provider":"sotamodel","model":"claude-opus-5-max"}]}

# 单次 Run 的模型预算上限。达到 70% / 90% 时审计报告会给出 budget_warning / budget_critical。
QUESTLAB_MODEL_MAX_COST_USD=2
QUESTLAB_MODEL_MAX_TOKENS=120000
QUESTLAB_MODEL_MAX_DURATION_SEC=1800
