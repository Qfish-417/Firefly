{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefly.questlab/schemas/v1/contracts.json",
  "title": "FireFly QuestLab contracts v1",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "scope",
        "owner_id",
        "lineage_ids"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/Identifier" },
        "uri": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/Digest" },
        "media_type": { "type": "string", "minLength": 3, "maxLength": 128 },
        "scope": {
          "enum": ["public", "tenant", "agent-private", "user-private", "session"]
        },
        "owner_id": { "$ref": "#/$defs/Identifier" },
        "lineage_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "uniqueItems": true
        }
      }
    },
    "RetryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "initial_backoff_ms", "max_backoff_ms"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "initial_backoff_ms": { "type": "integer", "minimum": 0 },
        "max_backoff_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "TaskLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_sec", "heartbeat_sec"],
      "properties": {
        "duration_sec": { "type": "integer", "minimum": 5, "maximum": 86400 },
        "heartbeat_sec": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "TaskBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_cost_usd", "max_duration_sec"],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "max_duration_sec": { "type": "integer", "minimum": 1 }
      }
    },
    "GovernanceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_run_id",
        "hop_count",
        "max_hops",
        "task_fingerprint",
        "policy_snapshot",
        "epoch"
      ],
      "properties": {
        "root_run_id": { "$ref": "#/$defs/Identifier" },
        "parent_task_id": { "$ref": "#/$defs/Identifier" },
        "hop_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "max_hops": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "task_fingerprint": { "$ref": "#/$defs/Digest" },
        "policy_snapshot": { "$ref": "#/$defs/Identifier" },
        "epoch": { "type": "integer", "minimum": 0 },
        "cooldown_key": { "$ref": "#/$defs/Identifier" }
      }
    },
    "TaskEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "correlation_id",
        "trace_id",
        "producer",
        "subject",
        "idempotency_key",
        "created_at",
        "deadline",
        "cancellation_token",
        "lease",
        "retry_policy",
        "budget",
        "artifact_refs",
        "payload"
      ],
      "properties": {
        "message_id": { "$ref": "#/$defs/Identifier" },
        "message_type": { "$ref": "#/$defs/Identifier" },
        "schema_version": { "const": 1 },
        "correlation_id": { "$ref": "#/$defs/Identifier" },
        "causation_id": { "$ref": "#/$defs/Identifier" },
        "trace_id": { "$ref": "#/$defs/Identifier" },
        "producer": { "$ref": "#/$defs/Identifier" },
        "subject": { "$ref": "#/$defs/Identifier" },
        "idempotency_key": { "type": "string", "minLength": 4, "maxLength": 256 },
        "created_at": { "type": "string", "format": "date-time" },
        "deadline": { "type": "string", "format": "date-time" },
        "cancellation_token": { "$ref": "#/$defs/Identifier" },
        "lease": { "$ref": "#/$defs/TaskLease" },
        "retry_policy": { "$ref": "#/$defs/RetryPolicy" },
        "budget": { "$ref": "#/$defs/TaskBudget" },
        "governance": { "$ref": "#/$defs/GovernanceContext" },
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "payload": { "type": "object" }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "correlation_id",
        "trace_id",
        "producer",
        "idempotency_key",
        "occurred_at",
        "artifact_refs",
        "payload"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/Identifier" },
        "event_type": { "$ref": "#/$defs/Identifier" },
        "schema_version": { "const": 1 },
        "correlation_id": { "$ref": "#/$defs/Identifier" },
        "causation_id": { "$ref": "#/$defs/Identifier" },
        "trace_id": { "$ref": "#/$defs/Identifier" },
        "producer": { "$ref": "#/$defs/Identifier" },
        "idempotency_key": { "type": "string", "minLength": 4, "maxLength": 256 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "governance": { "$ref": "#/$defs/GovernanceContext" },
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "payload": { "type": "object" }
      }
    },
    "ExecutionSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_version"],
      "properties": {
        "input_version": { "$ref": "#/$defs/Identifier" },
        "model": { "$ref": "#/$defs/Identifier" },
        "prompt": { "$ref": "#/$defs/Identifier" },
        "tools": { "$ref": "#/$defs/Identifier" },
        "knowledge": { "$ref": "#/$defs/Identifier" }
      }
    },
    "AgentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "task_id",
        "schema_version",
        "status",
        "completed_at",
        "snapshots",
        "artifact_refs",
        "output"
      ],
      "properties": {
        "result_id": { "$ref": "#/$defs/Identifier" },
        "task_id": { "$ref": "#/$defs/Identifier" },
        "schema_version": { "const": 1 },
        "status": { "enum": ["completed", "failed", "canceled", "needs_human"] },
        "completed_at": { "type": "string", "format": "date-time" },
        "snapshots": { "$ref": "#/$defs/ExecutionSnapshots" },
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "output": { "type": "object" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/Identifier" },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "failed" } } },
          "then": {
            "required": ["error"],
            "properties": { "error": true }
          }
        }
      ]
    },
    "PluginExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "version", "digest"],
      "properties": {
        "plugin_id": { "$ref": "#/$defs/Identifier" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/Digest" }
      }
    },
    "LearningEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "learner_id",
        "world_id",
        "mission_id",
        "event_type",
        "occurred_at",
        "artifact_refs",
        "attributes"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/Identifier" },
        "learner_id": { "$ref": "#/$defs/Identifier" },
        "world_id": { "$ref": "#/$defs/Identifier" },
        "mission_id": { "$ref": "#/$defs/Identifier" },
        "event_type": {
          "enum": [
            "mission_activated",
            "challenge_attempted",
            "artifact_submitted",
            "assessment_completed",
            "hint_consumed",
            "delayed_review_completed",
            "transfer_task_completed"
          ]
        },
        "occurred_at": { "type": "string", "format": "date-time" },
        "plugin_exposure": { "$ref": "#/$defs/PluginExposure" },
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "attributes": { "type": "object" }
      }
    },
    "SuccessCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_harm_constraints"],
      "properties": {
        "mastery_delta": { "type": "number", "minimum": -1, "maximum": 1 },
        "delayed_retention_delta": { "type": "number", "minimum": -1, "maximum": 1 },
        "transfer_success_delta": { "type": "number", "minimum": -1, "maximum": 1 },
        "no_harm_constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        }
      }
    },
    "LearningFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "scope",
        "problem",
        "evidence_refs",
        "affected_concepts",
        "confidence",
        "severity",
        "recommended_change_type",
        "success_criteria"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/Identifier" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["world_id"],
          "properties": {
            "world_id": { "$ref": "#/$defs/Identifier" },
            "plugin_version": { "type": "string", "minLength": 1 },
            "cohort": { "$ref": "#/$defs/Identifier" }
          }
        },
        "problem": { "type": "string", "minLength": 10 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "affected_concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "recommended_change_type": {
          "enum": ["instruction", "plugin", "plugin_and_instruction"]
        },
        "success_criteria": { "$ref": "#/$defs/SuccessCriteria" }
      }
    },
    "ImprovementPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "finding_id",
        "status",
        "change_class",
        "target_artifact",
        "allowed_paths",
        "risk_level",
        "verification_contract",
        "rollback_target"
      ],
      "properties": {
        "plan_id": { "$ref": "#/$defs/Identifier" },
        "finding_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["proposed", "approved", "rejected"] },
        "change_class": { "enum": ["A1", "A2", "A3"] },
        "target_artifact": { "$ref": "#/$defs/ArtifactRef" },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "verification_contract": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "rollback_target": { "$ref": "#/$defs/ArtifactRef" },
        "approved_by": { "$ref": "#/$defs/Identifier" },
        "approved_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": {
            "required": ["approved_by", "approved_at"],
            "properties": {
              "approved_by": true,
              "approved_at": true
            }
          }
        }
      ]
    },
    "PatchProposalFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_digest", "byte_length"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "content_digest": { "$ref": "#/$defs/Digest" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "PatchProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "plan_id",
        "source_snapshot",
        "proposal_artifact",
        "files",
        "risk_declaration"
      ],
      "properties": {
        "proposal_id": { "$ref": "#/$defs/Identifier" },
        "plan_id": { "$ref": "#/$defs/Identifier" },
        "source_snapshot": { "$ref": "#/$defs/ArtifactRef" },
        "proposal_artifact": { "$ref": "#/$defs/ArtifactRef" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/PatchProposalFile" }
        },
        "risk_declaration": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "ChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeset_id",
        "plan_id",
        "source_snapshot",
        "patch_commit",
        "plugin_artifact",
        "generated_tests",
        "changed_paths",
        "risk_declaration"
      ],
      "properties": {
        "changeset_id": { "$ref": "#/$defs/Identifier" },
        "plan_id": { "$ref": "#/$defs/Identifier" },
        "source_snapshot": { "$ref": "#/$defs/ArtifactRef" },
        "patch_commit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
        "plugin_artifact": { "$ref": "#/$defs/ArtifactRef" },
        "generated_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_declaration": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "VerificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence_refs"],
      "properties": {
        "name": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" }
        }
      }
    },
    "VerificationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "changeset_id", "status", "baseline_snapshot", "checks"],
      "properties": {
        "report_id": { "$ref": "#/$defs/Identifier" },
        "changeset_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["passed", "failed"] },
        "baseline_snapshot": { "$ref": "#/$defs/ArtifactRef" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/VerificationCheck" }
        }
      }
    },
    "LearningOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "plan_id",
        "plugin_artifact",
        "cohort",
        "metrics",
        "decision",
        "evidence_refs"
      ],
      "properties": {
        "outcome_id": { "$ref": "#/$defs/Identifier" },
        "plan_id": { "$ref": "#/$defs/Identifier" },
        "plugin_artifact": { "$ref": "#/$defs/ArtifactRef" },
        "cohort": { "$ref": "#/$defs/Identifier" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mastery_delta",
            "delayed_retention_delta",
            "transfer_success_delta",
            "harm_signals"
          ],
          "properties": {
            "mastery_delta": { "type": "number", "minimum": -1, "maximum": 1 },
            "delayed_retention_delta": { "type": "number", "minimum": -1, "maximum": 1 },
            "transfer_success_delta": { "type": "number", "minimum": -1, "maximum": 1 },
            "harm_signals": { "type": "integer", "minimum": 0 }
          }
        },
        "decision": {
          "enum": ["recommend_activate", "recommend_rollback", "needs_human"]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ArtifactRef" }
        }
      }
    },
    "QueryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "query_id",
        "intent",
        "structured_query_required",
        "answer_source",
        "stages",
        "candidate_k",
        "fusion_k",
        "rerank_k",
        "context_k",
        "min_context_k",
        "max_context_tokens",
        "score_floor",
        "marginal_gain_floor",
        "evidence_coverage_target"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "query_id": { "$ref": "#/$defs/Identifier" },
        "intent": {
          "enum": [
            "fact_lookup",
            "count_events",
            "comparison",
            "multi_hop",
            "exploratory",
            "temporal",
            "multimodal"
          ]
        },
        "structured_query_required": { "type": "boolean" },
        "answer_source": { "enum": ["rag", "structured", "structured_plus_evidence"] },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["structured", "lexical", "vector", "graph", "temporal", "multimodal"]
          }
        },
        "candidate_k": { "type": "integer", "minimum": 1, "maximum": 100 },
        "fusion_k": { "type": "integer", "minimum": 1, "maximum": 150 },
        "rerank_k": { "type": "integer", "minimum": 1, "maximum": 50 },
        "context_k": { "type": "integer", "minimum": 1, "maximum": 30 },
        "min_context_k": { "type": "integer", "minimum": 1, "maximum": 30 },
        "max_context_tokens": { "type": "integer", "minimum": 1 },
        "score_floor": { "type": "number", "minimum": 0, "maximum": 1 },
        "marginal_gain_floor": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_coverage_target": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": { "enum": ["count_events", "comparison", "multi_hop", "temporal"] }
            },
            "required": ["intent"]
          },
          "then": {
            "properties": {
              "structured_query_required": { "const": true },
              "answer_source": { "const": "structured_plus_evidence" },
              "stages": {
                "type": "array",
                "contains": { "const": "structured" },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": { "structured_query_required": { "const": true } },
            "required": ["structured_query_required"]
          },
          "then": {
            "properties": {
              "stages": {
                "type": "array",
                "contains": { "const": "structured" },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "EvidenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "uri", "digest"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/Identifier" },
        "uri": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/Digest" },
        "locator": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "number" }]
          }
        }
      }
    },
    "StructuredResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "value", "included_ids", "excluded_reasons", "conflicts"],
      "properties": {
        "operation": { "enum": ["count_distinct", "group_by", "comparison", "path", "temporal"] },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "included_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "excluded_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "EvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "untrusted_content",
        "score",
        "source_type",
        "entity_keys",
        "citation"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/Identifier" },
        "untrusted_content": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_type": { "$ref": "#/$defs/Identifier" },
        "entity_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "citation": { "$ref": "#/$defs/EvidenceCitation" }
      }
    },
    "EvidencePackRetrieverTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "returned", "failed"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "stage": { "enum": ["lexical", "vector", "graph", "temporal", "multimodal"] },
        "returned": { "type": "integer", "minimum": 0 },
        "failed": { "type": "boolean" }
      }
    },
    "EvidencePackTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrievers", "fused", "authorized", "denied", "selected", "stop_reason"],
      "properties": {
        "retrievers": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidencePackRetrieverTrace" }
        },
        "fused": { "type": "integer", "minimum": 0 },
        "authorized": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 0 },
        "stop_reason": { "enum": ["context_k", "token_budget", "score_floor", "exhausted"] }
      }
    },
    "EvidencePack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "query_id",
        "original_query",
        "status",
        "plan",
        "evidence",
        "conflicts",
        "coverage",
        "citation_required",
        "allowed_usage",
        "generation_allowed",
        "trace"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "query_id": { "$ref": "#/$defs/Identifier" },
        "original_query": { "type": "string", "minLength": 1 },
        "status": { "enum": ["sufficient", "insufficient"] },
        "plan": { "$ref": "#/$defs/QueryPlan" },
        "structured_result": { "$ref": "#/$defs/StructuredResult" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceItem" }
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "citation_required": { "type": "boolean" },
        "allowed_usage": { "type": "string", "minLength": 1, "maxLength": 256 },
        "generation_allowed": { "type": "boolean" },
        "trace": { "$ref": "#/$defs/EvidencePackTrace" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "insufficient" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "generation_allowed": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "generation_allowed": { "const": true } },
            "required": ["generation_allowed"]
          },
          "then": {
            "properties": {
              "status": { "const": "sufficient" },
              "evidence": { "type": "array", "minItems": 1 },
              "conflicts": { "type": "array", "maxItems": 0 },
              "structured_result": {
                "type": "object",
                "properties": {
                  "conflicts": { "type": "array", "maxItems": 0 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "conflicts": { "type": "array", "minItems": 1 } },
            "required": ["conflicts"]
          },
          "then": {
            "properties": { "generation_allowed": { "const": false } }
          }
        },
        {
          "if": {
            "properties": {
              "plan": {
                "type": "object",
                "properties": { "structured_query_required": { "const": true } },
                "required": ["structured_query_required"]
              }
            },
            "required": ["plan"]
          },
          "then": {
            "required": ["structured_result"],
            "properties": {
              "structured_result": { "$ref": "#/$defs/StructuredResult" }
            }
          }
        }
      ]
    },
    "IndexBuildTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "index_version_id",
        "tenant_id",
        "logical_name",
        "index_kind",
        "provider",
        "source_watermark",
        "configuration_digest",
        "requested_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "build_id": { "$ref": "#/$defs/Identifier" },
        "index_version_id": { "$ref": "#/$defs/Identifier" },
        "tenant_id": { "$ref": "#/$defs/Identifier" },
        "logical_name": { "$ref": "#/$defs/Identifier" },
        "index_kind": { "enum": ["lexical", "vector", "hybrid", "multimodal"] },
        "provider": { "$ref": "#/$defs/Identifier" },
        "source_watermark": { "type": "string", "minLength": 1, "maxLength": 256 },
        "configuration_digest": { "$ref": "#/$defs/Digest" },
        "embedding_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "embedding_dimensions": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "requested_at": { "type": "string", "format": "date-time" }
      },
      "dependentRequired": {
        "embedding_model": ["embedding_dimensions"],
        "embedding_dimensions": ["embedding_model"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "index_kind": { "enum": ["vector", "multimodal"] } },
            "required": ["index_kind"]
          },
          "then": {
            "required": ["embedding_model", "embedding_dimensions"],
            "properties": {
              "embedding_model": { "type": "string", "minLength": 1 },
              "embedding_dimensions": { "type": "integer", "minimum": 1, "maximum": 4096 }
            }
          }
        }
      ]
    },
    "IndexEvaluationPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/Identifier" },
        "user_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "$ref": "#/$defs/Identifier" },
        "session_id": { "$ref": "#/$defs/Identifier" },
        "role_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        }
      }
    },
    "IndexEvaluationCitationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "artifact_id", "uri", "digest"],
      "properties": {
        "memory_id": { "$ref": "#/$defs/Identifier" },
        "artifact_id": { "$ref": "#/$defs/Identifier" },
        "uri": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/Digest" },
        "locator": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "number" }]
          }
        }
      }
    },
    "IndexEvaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "stage",
        "query",
        "purpose",
        "principal",
        "max_results",
        "expected_memory_ids",
        "forbidden_memory_ids",
        "expected_citations"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/Identifier" },
        "stage": { "enum": ["lexical", "vector", "hybrid"] },
        "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
        "query_embedding": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "type": "number" }
        },
        "embedding_model": { "$ref": "#/$defs/Identifier" },
        "principal": { "$ref": "#/$defs/IndexEvaluationPrincipal" },
        "max_results": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "expected_memory_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "forbidden_memory_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "expected_citations": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/IndexEvaluationCitationExpectation" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "stage": { "enum": ["vector", "hybrid"] } } },
          "then": {
            "required": ["query_embedding", "embedding_model"],
            "properties": { "query_embedding": {}, "embedding_model": {} }
          }
        },
        {
          "if": { "required": ["query_embedding"], "properties": { "query_embedding": {} } },
          "then": { "properties": { "stage": { "enum": ["vector", "hybrid"] } } }
        },
        {
          "if": { "required": ["embedding_model"], "properties": { "embedding_model": {} } },
          "then": { "properties": { "stage": { "enum": ["vector", "hybrid"] } } }
        }
      ]
    },
    "IndexEvaluationThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acl", "recall", "citation"],
      "properties": {
        "acl": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "citation": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "IndexEvaluationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_set_id",
        "logical_name",
        "thresholds",
        "cases",
        "artifact_ref"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "evaluation_set_id": { "$ref": "#/$defs/Identifier" },
        "logical_name": { "$ref": "#/$defs/Identifier" },
        "thresholds": { "$ref": "#/$defs/IndexEvaluationThresholds" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/IndexEvaluationCase" }
        },
        "artifact_ref": { "$ref": "#/$defs/ArtifactRef" }
      }
    },
    "IndexQualityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "score", "threshold", "sample_size", "summary", "evidence_refs"],
      "properties": {
        "name": { "enum": ["structure", "source_watermark", "acl", "recall", "citation"] },
        "passed": { "type": "boolean" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "sample_size": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/ArtifactRef" }
        }
      }
    },
    "IndexQualityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_id",
        "build_id",
        "index_version_id",
        "source_watermark",
        "configuration_digest",
        "passed",
        "checks",
        "evaluated_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "report_id": { "$ref": "#/$defs/Identifier" },
        "build_id": { "$ref": "#/$defs/Identifier" },
        "index_version_id": { "$ref": "#/$defs/Identifier" },
        "source_watermark": { "type": "string", "minLength": 1, "maxLength": 256 },
        "configuration_digest": { "$ref": "#/$defs/Digest" },
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/IndexQualityCheck" }
        },
        "evaluated_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "passed": { "const": true } },
            "required": ["passed"]
          },
          "then": {
            "properties": {
              "checks": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/IndexQualityCheck" },
                    { "type": "object", "properties": { "passed": { "const": true } }, "required": ["passed"] }
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "checks": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "passed": { "const": false } },
                  "required": ["passed"]
                }
              }
            }
          }
        }
      ]
    },
    "IndexBuildResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "index_version_id",
        "status",
        "document_count",
        "chunk_count",
        "source_watermark",
        "completed_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "build_id": { "$ref": "#/$defs/Identifier" },
        "index_version_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["ready", "failed"] },
        "document_count": { "type": "integer", "minimum": 0 },
        "chunk_count": { "type": "integer", "minimum": 0 },
        "source_watermark": { "type": "string", "minLength": 1, "maxLength": 256 },
        "completed_at": { "type": "string", "format": "date-time" },
        "quality_report": { "$ref": "#/$defs/IndexQualityReport" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/Identifier" },
            "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "retryable": { "type": "boolean" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["error"],
            "properties": { "error": { "$ref": "#/$defs/IndexBuildResult/properties/error" } }
          }
        },
        {
          "if": {
            "properties": {
              "quality_report": {
                "type": "object",
                "properties": { "passed": { "const": false } },
                "required": ["passed"]
              }
            },
            "required": ["quality_report"]
          },
          "then": {
            "properties": { "status": { "const": "failed" } }
          }
        }
      ]
    },
    "DeletionPropagationTarget": {
      "enum": [
        "object_store",
        "external_lexical",
        "external_vector",
        "multimodal_index",
        "cache",
        "summary",
        "evaluation"
      ]
    },
    "DeletionPropagationTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "deletion_id",
        "memory_id",
        "tenant_id",
        "target",
        "content_digest",
        "resource_refs",
        "requested_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "deletion_id": { "$ref": "#/$defs/Identifier" },
        "memory_id": { "$ref": "#/$defs/Identifier" },
        "tenant_id": { "$ref": "#/$defs/Identifier" },
        "target": { "$ref": "#/$defs/DeletionPropagationTarget" },
        "content_digest": { "$ref": "#/$defs/Digest" },
        "resource_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    },
    "DeletionPropagationAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ack_id",
        "deletion_id",
        "target",
        "status",
        "attempt",
        "occurred_at",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "ack_id": { "$ref": "#/$defs/Identifier" },
        "deletion_id": { "$ref": "#/$defs/Identifier" },
        "target": { "$ref": "#/$defs/DeletionPropagationTarget" },
        "status": { "enum": ["completed", "failed"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/Identifier" },
            "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "retryable": { "type": "boolean" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["error"],
            "properties": { "error": { "$ref": "#/$defs/DeletionPropagationAck/properties/error" } }
          }
        }
      ]
    }
  }
}
