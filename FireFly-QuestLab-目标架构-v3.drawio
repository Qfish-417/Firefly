        <mxCell id="p23-data-band" value="Digest-bound evaluation identity" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="45" y="85" width="1510" height="225" as="geometry"/></mxCell>
