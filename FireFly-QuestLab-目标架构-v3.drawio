        <mxCell id="p35-failure" value="Fail closed&#xa;missing formula result | bad headers | unsupported cell | limits&#xa;macros, formulas and external links never execute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9372C;fontSize=13;" vertex="1" parent="p35-1"><mxGeometry x="1230" y="430" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="p35-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p35-1" source="p35-source" target="p35-parser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p35-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p35-1" source="p35-parser" target="p35-validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p35-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p35-1" source="p35-validation" target="p35-structure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p35-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p35-1" source="p35-structure" target="p35-chunker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p35-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p35-1" source="p35-validation" target="p35-failure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p35-boundary" value="Boundary: sheet/table values are indexed. Merged-cell semantics, charts, embedded images, macros and formula recalculation remain outside this parser." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p35-1"><mxGeometry x="200" y="920" width="1200" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-governed-http-ocr" name="36-M5.19 Governed HTTP OCR Layout">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p36-0"/><mxCell id="p36-1" parent="p36-0"/>
        <mxCell id="p36-title" value="M5.19 Governed OCR: native text first, verified binary OCR only for scanned documents" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p36-1"><mxGeometry x="90" y="20" width="1420" height="50" as="geometry"/></mxCell>
        <mxCell id="p36-artifact" value="Immutable binary Artifact&#xa;s3:// hydration | byte limit&#xa;Citation SHA-256 verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p36-1"><mxGeometry x="60" y="150" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="p36-native" value="PDF.js native extraction&#xa;born-digital text + point bbox&#xa;page/item/text budgets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p36-1"><mxGeometry x="450" y="150" width="310" height="140" as="geometry"/></mxCell>
        <mxCell id="p36-route" value="Explicit route decision&#xa;success -> native layout&#xa;NO_EXTRACTABLE_TEXT -> OCR&#xa;all other errors fail closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p36-1"><mxGeometry x="850" y="140" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="p36-provider" value="HttpOcrLayoutParser&#xa;fixed HTTPS endpoint | no redirects&#xa;multipart metadata + verified bytes&#xa;timeout and response byte limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p36-1"><mxGeometry x="1220" y="360" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="p36-contract" value="firefly.ocr-layout.v1 validation&#xa;echoed digest + provider/model identity&#xa;contiguous page/block reading order&#xa;pixel size | unique region | bbox | confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p36-1"><mxGeometry x="830" y="430" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="p36-layout" value="Unified IndexPdfLayoutSource&#xa;native or OCR extraction provenance&#xa;page geometry + blocks + quality metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p36-1"><mxGeometry x="410" y="450" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="p36-chunker" value="PdfLayoutChunker&#xa;Parent page context + Child recall&#xa;Citation keeps provider/model/page/bbox/confidence/language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p36-1"><mxGeometry x="410" y="730" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="p36-ops" value="Deployment governance&#xa;credential rotation | outbound allowlist | rate limit&#xa;data residency + retention | provider observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p36-1"><mxGeometry x="1040" y="730" width="430" height="140" as="geometry"/></mxCell>
        <mxCell id="p36-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p36-1" source="p36-artifact" target="p36-native"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p36-1" source="p36-native" target="p36-route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p36-1" source="p36-route" target="p36-provider"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p36-1" source="p36-provider" target="p36-contract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p36-1" source="p36-contract" target="p36-layout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p36-1" source="p36-route" target="p36-layout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p36-1" source="p36-layout" target="p36-chunker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;strokeColor=#5E6C84;" edge="1" parent="p36-1" source="p36-provider" target="p36-ops"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p36-boundary" value="Boundary: OCR is derived evidence and never repairs malformed, oversized or unverified PDFs. The concrete OCR engine remains replaceable behind this contract." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p36-1"><mxGeometry x="220" y="925" width="1160" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-governed-http-asr" name="37-M5.20 Governed HTTP ASR and Diarization">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p37-0"/><mxCell id="p37-1" parent="p37-0"/>
        <mxCell id="p37-title" value="M5.20 Governed ASR and Diarization: verified audio to replayable conversation evidence" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p37-1"><mxGeometry x="90" y="20" width="1420" height="50" as="geometry"/></mxCell>
        <mxCell id="p37-artifact" value="Immutable audio Artifact&#xa;s3:// hydration | MIME/byte limit&#xa;Citation SHA-256 verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p37-1"><mxGeometry x="60" y="160" width="310" height="145" as="geometry"/></mxCell>
        <mxCell id="p37-provider" value="HttpAsrDiarizationParser&#xa;fixed HTTPS endpoint | no redirects&#xa;multipart metadata + verified audio&#xa;timeout and response limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p37-1"><mxGeometry x="465" y="150" width="350" height="165" as="geometry"/></mxCell>
        <mxCell id="p37-contract" value="firefly.asr-diarization.v1&#xa;echo digest + provider/model identity&#xa;duration + diarization state&#xa;ordered turn/speaker/time/confidence/language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p37-1"><mxGeometry x="910" y="145" width="390" height="175" as="geometry"/></mxCell>
        <mxCell id="p37-validation" value="Deterministic validation&#xa;sequence and unique turn identity&#xa;offsets inside duration | speaker consistency&#xa;source/turn/speaker/text hard limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p37-1"><mxGeometry x="1190" y="430" width="340" height="180" as="geometry"/></mxCell>
        <mxCell id="p37-source" value="IndexConversationSource&#xa;provider-neutral timed turns&#xa;no role inference and no manufactured wall clock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p37-1"><mxGeometry x="650" y="455" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="p37-chunker" value="ConversationTurnChunker&#xa;Parent contiguous window + Child turn recall&#xa;Citation keeps media range, confidence, language, model and diarization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p37-1"><mxGeometry x="500" y="730" width="600" height="145" as="geometry"/></mxCell>
        <mxCell id="p37-ops" value="Deployment governance&#xa;credential rotation | rate/cost limit&#xa;data residency + audio retention&#xa;low-confidence human review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p37-1"><mxGeometry x="1160" y="730" width="370" height="145" as="geometry"/></mxCell>
        <mxCell id="p37-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p37-1" source="p37-artifact" target="p37-provider"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p37-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p37-1" source="p37-provider" target="p37-contract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p37-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p37-1" source="p37-contract" target="p37-validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p37-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p37-1" source="p37-validation" target="p37-source"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p37-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p37-1" source="p37-source" target="p37-chunker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p37-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;strokeColor=#5E6C84;" edge="1" parent="p37-1" source="p37-provider" target="p37-ops"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p37-boundary" value="Boundary: ASR is derived evidence. Speaker labels never imply user/assistant roles, and media offsets remain relative to the immutable audio Artifact." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p37-1"><mxGeometry x="220" y="925" width="1160" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-structured-comparison-temporal" name="38-M5.25 Structured Comparison and Temporal Aggregation">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p38-0"/><mxCell id="p38-1" parent="p38-0"/>
        <mxCell id="p38-title" value="M5.25 Structured truth: deterministic comparison and temporal selection" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p38-1"><mxGeometry x="90" y="20" width="1420" height="50" as="geometry"/></mxCell>
        <mxCell id="p38-user" value="User question&#xa;compare two subjects | first/last event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="55" y="140" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="p38-http" value="Retrieval HTTP boundary&#xa;intent + discriminated structured_query&#xa;exact fields | IDs | ISO range&#xa;same-subject and selector checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="415" y="115" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="p38-gateway" value="Governed Retrieval Gateway&#xa;structured result is required&#xa;RAG evidence supports citations only&#xa;conflict blocks generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="855" y="115" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="p38-aggregator" value="PostgresStructuredEventAggregator&#xa;adapter-level time validation&#xa;comparison | temporal&#xa;graph follow-up: ADR 0040" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="1245" y="115" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="p38-fact" value="StructuredEvent fact layer&#xa;scope + owner + tenant ACL&#xa;subject | event_type | occurred interval&#xa;dedupe_key | conflict | provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="620" y="390" width="360" height="180" as="geometry"/></mxCell>
        <mxCell id="p38-policy" value="Deterministic normalization&#xa;ACL before aggregation&#xa;occurred_from ASC, event_id ASC&#xa;first row per dedupe_key&#xa;conflicts always surfaced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="1080" y="390" width="360" height="180" as="geometry"/></mxCell>
        <mxCell id="p38-comparison" value="comparison_counts&#xa;one event type + optional window&#xa;left distinct count - right distinct count&#xa;both operands + included IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="330" y="695" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="p38-temporal" value="temporal_event&#xa;first or last distinct event&#xa;event ID + occurred_from/to&#xa;explicit null when absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p38-1"><mxGeometry x="850" y="695" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="p38-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p38-1" source="p38-user" target="p38-http"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p38-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p38-1" source="p38-http" target="p38-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p38-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p38-1" source="p38-gateway" target="p38-aggregator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p38-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p38-1" source="p38-aggregator" target="p38-fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p38-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p38-1" source="p38-fact" target="p38-policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p38-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p38-1" source="p38-policy" target="p38-comparison"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p38-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p38-1" source="p38-policy" target="p38-temporal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p38-boundary" value="Boundary: TopK RAG cannot prove a complete count or event ordering. Structured truth authorizes the scalar; retrieved chunks can only support explanation and citations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p38-1"><mxGeometry x="200" y="920" width="1200" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-structured-edge-multi-hop" name="39-M5.26 Governed Structured-Edge Multi-Hop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p39-0"/><mxCell id="p39-1" parent="p39-0"/>
        <mxCell id="p39-title" value="M5.26 Governed multi-hop: versioned graph facts, bounded traversal and memory provenance" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p39-1"><mxGeometry x="80" y="20" width="1440" height="50" as="geometry"/></mxCell>
        <mxCell id="p39-request" value="find_relation_path&#xa;start / target / predicates&#xa;outbound | inbound | both&#xa;as_of + max_hops 1..6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="55" y="130" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="p39-http" value="HTTP + adapter validation&#xa;exact discriminated fields&#xa;different nodes | unique predicates&#xa;invalid requests fail before DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="430" y="130" width="330" height="155" as="geometry"/></mxCell>
        <mxCell id="p39-acl" value="MemoryRepository.listReadableEdges&#xa;public / tenant / user / Agent / session ACL&#xa;valid_from &amp;lt;= as_of &amp;lt; valid_to&#xa;predicate filter + governed row limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="840" y="115" width="370" height="185" as="geometry"/></mxCell>
        <mxCell id="p39-edge" value="StructuredEdge v1 truth layer&#xa;source - predicate - target&#xa;directed | bidirectional&#xa;scope + validity + dedupe + confidence&#xa;source Memory IDs + conflict status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="1260" y="105" width="300" height="205" as="geometry"/></mxCell>
        <mxCell id="p39-bfs" value="Deterministic bounded BFS&#xa;stable edge ordering and dedupe&#xa;visited-node cycle prevention&#xa;shortest path | &amp;lt;= 6 hops&#xa;graph size cap + AbortSignal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="560" y="430" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="p39-conflict" value="Conflict governance&#xa;reachable conflicts always surfaced&#xa;excluded conflicts counted&#xa;included conflicts still block generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="1080" y="445" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="p39-result" value="relation_path result&#xa;found + hop_count&#xa;exact node sequence + edge hops&#xa;not found = null + empty arrays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="300" y="745" width="390" height="160" as="geometry"/></mxCell>
        <mxCell id="p39-delete" value="Memory deletion transaction&#xa;remove dependent StructuredEdges&#xa;invalidated_edge_count in receipt&#xa;Outbox preserves audit evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p39-1"><mxGeometry x="870" y="745" width="390" height="160" as="geometry"/></mxCell>
        <mxCell id="p39-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p39-1" source="p39-request" target="p39-http"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p39-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p39-1" source="p39-http" target="p39-acl"><mxGeometry relative="1" as="geometry"/></mxCell>
