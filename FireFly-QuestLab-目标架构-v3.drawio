        <mxCell id="p13-retrievers" value="Parallel Retriever Ports&#xa;Lexical / Vector / Graph&#xa;Temporal / Multimodal&#xa;provider failures are traced" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p13-1"><mxGeometry x="790" y="115" width="350" height="205" as="geometry"/></mxCell>
        <mxCell id="p13-rrf" value="Independent rank lists&#xa;RRF + dedupe&#xa;immutable ID conflict fails closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p13-retrievers"><mxGeometry x="35" y="75" width="280" height="95" as="geometry"/></mxCell>
