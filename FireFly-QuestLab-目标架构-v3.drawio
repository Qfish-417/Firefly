  <diagram id="v3-deletion-reconciliation-scheduler" name="21-M5.5删除Reconciliation周期调度">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p21-0"/><mxCell id="p21-1" parent="p21-0"/>
        <mxCell id="p21-title" value="M5.5 Deletion Reconciliation: bounded recovery without duplicate side effects" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p21-1"><mxGeometry x="100" y="20" width="1400" height="50" as="geometry"/></mxCell>

        <mxCell id="p21-scan-band" value="Periodic trigger and bounded candidate selection" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="45" y="85" width="1510" height="245" as="geometry"/></mxCell>
        <mxCell id="p21-failed" value="Failed deletion targets&#xa;status = failed&#xa;updated_at watermark" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="90" y="150" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-scheduler" value="Periodic Scheduler&#xa;runOnce coalescing&#xa;one in-flight cycle per instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="455" y="150" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-window" value="Bounded scan window&#xa;stale cutoff&#xa;validated batch limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="845" y="150" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-candidates" value="Candidate scan&#xa;stale failed targets only&#xa;bounded result set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="1215" y="150" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-s1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p21-1" source="p21-failed" target="p21-scheduler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-s2" value="tick" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p21-1" source="p21-scheduler" target="p21-window"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-s3" value="query" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p21-1" source="p21-window" target="p21-candidates"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p21-tx-band" value="Per-target database transaction: concurrency safety belongs to durable state" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="45" y="365" width="1510" height="280" as="geometry"/></mxCell>
        <mxCell id="p21-lock" value="Row lock&#xa;serialize target mutation&#xa;across replicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="1280" y="445" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-recheck" value="State recheck&#xa;still failed?&#xa;otherwise no-op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="985" y="445" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-outbox" value="Deterministic Outbox retry&#xa;identity is idempotent&#xa;same transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="670" y="445" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-pending" value="Target pending&#xa;attempt increases&#xa;ready for reclaim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="375" y="445" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-worker" value="DeletionPropagationWorker&#xa;provider side effect&#xa;Ack completed | failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="80" y="445" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-t0" value="each target" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p21-1" source="p21-candidates" target="p21-lock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p21-1" source="p21-lock" target="p21-recheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t2" value="failed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p21-1" source="p21-recheck" target="p21-outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t3" value="commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p21-1" source="p21-outbox" target="p21-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t4" value="claim" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p21-1" source="p21-pending" target="p21-worker"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p21-ops-band" value="Lifecycle and observability boundaries" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="45" y="680" width="1510" height="270" as="geometry"/></mxCell>
        <mxCell id="p21-observe" value="Structured cycle result&#xa;scheduler / instance / cycle&#xa;cutoff / limit / count / duration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="80" y="750" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-failure" value="Failure isolation&#xa;failed cycle is observable&#xa;next interval still runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="455" y="750" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-observer" value="Observer isolation&#xa;observer failure increments counter&#xa;database fact stays unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="810" y="750" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-shutdown" value="AbortSignal shutdown&#xa;no new cycle after cancellation&#xa;in-flight transaction completes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="1185" y="750" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-boundary" value="Multi-replica rule: scheduler instances may scan concurrently; row lock + failed-state recheck + deterministic Outbox identity prevent duplicate durable work. Persistent run ledger, deployment alerts and provider evidence verification remain follow-up work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p21-1"><mxGeometry x="210" y="895" width="1180" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-retired-index-retention-gc" name="22-M5.6Retired索引保留期回收">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p22-0"/><mxCell id="p22-1" parent="p22-0"/>
        <mxCell id="p22-title" value="M5.6 Retired Index GC: reclaim projections, preserve audit evidence" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p22-1"><mxGeometry x="100" y="20" width="1400" height="50" as="geometry"/></mxCell>

        <mxCell id="p22-life-band" value="Version lifecycle: activation creates a rollback candidate" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="45" y="85" width="1510" height="220" as="geometry"/></mxCell>
        <mxCell id="p22-old-active" value="Index v1&#xa;status = active&#xa;query serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="90" y="145" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="p22-activation" value="Atomic activation&#xa;one tenant + logical name&#xa;one transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="455" y="145" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="p22-new-active" value="Index v2&#xa;status = active&#xa;new query target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="850" y="125" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="p22-retired" value="Index v1&#xa;status = retired&#xa;retired_at recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="1215" y="165" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="p22-l1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p22-1" source="p22-old-active" target="p22-activation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-l2" value="activate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p22-1" source="p22-activation" target="p22-new-active"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-l3" value="retire old" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p22-1" source="p22-activation" target="p22-retired"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p22-guard-band" value="Eligibility: retention age and explicit audit hold both fail closed" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="45" y="340" width="1510" height="250" as="geometry"/></mxCell>
        <mxCell id="p22-cutoff" value="Retention cutoff&#xa;now - retention period&#xa;default 7 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p22-1"><mxGeometry x="80" y="415" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p22-scan" value="Bounded candidate scan&#xa;retired + unpurged&#xa;retired_at at/before cutoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p22-1"><mxGeometry x="420" y="415" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="p22-hold" value="Retention Hold Registry&#xa;evaluation / incident / legal / audit&#xa;release or expires_at" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="790" y="405" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="p22-eligible" value="Eligibility gate&#xa;NO effective hold&#xa;otherwise skip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="1200" y="415" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="p22-g1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p22-1" source="p22-cutoff" target="p22-scan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-g2" value="candidates" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p22-1" source="p22-scan" target="p22-hold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-g3" value="check" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p22-1" source="p22-hold" target="p22-eligible"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p22-tx-band" value="Atomic purge: derived data is removed while immutable evidence survives" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="45" y="625" width="1510" height="325" as="geometry"/></mxCell>
        <mxCell id="p22-lock" value="FOR UPDATE SKIP LOCKED&#xa;multi-replica work sharing&#xa;version row serialization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="1240" y="700" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="p22-recheck" value="Transaction recheck&#xa;retired + unpurged&#xa;no effective hold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="930" y="700" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="p22-delete" value="Delete memory_chunk&#xa;all rows for version&#xa;Parent/Child together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p22-1"><mxGeometry x="620" y="700" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="p22-purged" value="Mark purged_at&#xa;keep status = retired&#xa;keep original chunk_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="320" y="700" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p22-event" value="RetrievalIndexPurged&#xa;deterministic Outbox ID&#xa;deleted count + identities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p22-1"><mxGeometry x="70" y="700" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="p22-t0" value="eligible" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p22-1" source="p22-eligible" target="p22-lock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-t1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p22-1" source="p22-lock" target="p22-recheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-t2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p22-1" source="p22-recheck" target="p22-delete"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-t3" value="same transaction" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p22-1" source="p22-delete" target="p22-purged"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-t4" value="audit fact" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p22-1" source="p22-purged" target="p22-event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22-boundary" value="Always retained: index version ID, build ID, tenant/logical name, source watermark, configuration Digest, original counts and quality report. Never eligible: active, ready, building, failed, recently retired, already purged, or effectively held versions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p22-1"><mxGeometry x="190" y="855" width="1220" height="65" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-vector-hybrid-fixed-evaluation" name="23-M5.7向量与混合固定评测">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
