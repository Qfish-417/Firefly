        <mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#44546F;" edge="1" parent="p4-1" source="p4-core" target="p4-data"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="v3-tools" name="05-工具与插件执行">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p5-0"/><mxCell id="p5-1" parent="p5-0"/>
        <mxCell id="p5-title" value="工具发现与执行：先发现最小能力集，再授权、固版本、执行与审计" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p5-1"><mxGeometry x="210" y="25" width="1180" height="50" as="geometry"/></mxCell>
        <mxCell id="p5-cats" value="五类目录：感知 Perception ｜ 执行 Action ｜ 协作 Collaboration ｜ 用户沟通 User Communication ｜ 事件触发 Event Trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="160" y="105" width="1280" height="70" as="geometry"/></mxCell>
        <mxCell id="p5-agent" value="Agent Bootstrap&#xa;tool.search / describe / invoke&#xa;status / cancel / artifact.read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="60" y="285" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-discovery" value="Capability Discovery&#xa;任务目标 → 分类 / 标签 / 语义检索&#xa;返回 3–8 个候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="350" y="285" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-registry" value="Tool / Plugin Registry&#xa;Descriptor / Manifest / SchemaHash&#xa;Version / Health / Signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="660" y="285" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-policy" value="Policy Engine&#xa;Agent / Tenant / Purpose / Consent&#xa;Risk / Budget / Tool Lease" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="980" y="285" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-broker" value="Tool Broker&#xa;固版本 / 幂等 / Resource Lock&#xa;Sync / Async / Stream / Cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="1290" y="285" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-sync" value="Sync Provider&#xa;短查询 / Schema 校验&#xa;只读状态 / 发现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="p5-1"><mxGeometry x="310" y="570" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="p5-async" value="Durable Plugin Release&#xa;Governed Task → Git Worktree / Commit&#xa;Sandbox → Approval → Canary → Rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="675" y="560" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-sandbox" value="Digest-pinned Docker Sandbox&#xa;Network none / Read-only / Cap drop&#xa;CPU / Memory / PID / Timeout limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;fontStyle=1;" vertex="1" parent="p5-1"><mxGeometry x="1070" y="560" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-cache" value="KV Cache：稳定前缀只放身份、Policy、事件契约和 Bootstrap Tools；按任务加载少量完整 Schema；任务内固定 Tool/Plugin Snapshot；Schema 或权限变更主动失效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p5-1"><mxGeometry x="210" y="785" width="1180" height="85" as="geometry"/></mxCell>
        <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p5-1" source="p5-agent" target="p5-discovery"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p5-1" source="p5-discovery" target="p5-registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p5-1" source="p5-registry" target="p5-policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e4" value="Tool Lease" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p5-1" source="p5-policy" target="p5-broker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p5-1" source="p5-broker" target="p5-sync"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p5-1" source="p5-broker" target="p5-async"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p5-1" source="p5-broker" target="p5-sandbox"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="v3-memory" name="06-知识记忆与检索">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p6-0"/><mxCell id="p6-1" parent="p6-0"/>
        <mxCell id="p6-title" value="知识与记忆：权限先于检索，聚合先于生成，派生记忆可回链原始证据" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p6-1"><mxGeometry x="170" y="25" width="1260" height="50" as="geometry"/></mxCell>
        <mxCell id="p6-query" value="用户问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p6-1"><mxGeometry x="50" y="155" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="p6-auth" value="Scope + Consent + ACL&#xa;先得到可检索集合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p6-1"><mxGeometry x="245" y="140" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="p6-rewrite" value="Intent + QueryPlan&#xa;澄清 / 重写 / 时间与实体约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p6-1"><mxGeometry x="500" y="140" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="p6-retrieve" value="Hybrid Retrieval&#xa;BM25 + Vector + Graph&#xa;RRF / Rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p6-1"><mxGeometry x="775" y="140" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p6-aggregate" value="SQL / Graph Aggregator&#xa;计数、去重、比较、状态判断&#xa;回答“几次/哪些/何时”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p6-1"><mxGeometry x="1040" y="130" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="p6-evidence" value="Evidence Assembly&#xa;充分性 / 冲突 / 引用 / DLP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p6-1"><mxGeometry x="1325" y="140" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p6-memory" value="记忆成熟阶段" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p6-1"><mxGeometry x="100" y="350" width="1400" height="190" as="geometry"/></mxCell>
        <mxCell id="p6-raw" value="Raw Evidence&#xa;不可变原始证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="p6-memory"><mxGeometry x="35" y="65" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="p6-episodic" value="Episodic&#xa;一次任务或交互摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="p6-memory"><mxGeometry x="305" y="65" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="p6-structured" value="Structured&#xa;实体、关系、指标、状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontStyle=1;" vertex="1" parent="p6-memory"><mxGeometry x="575" y="65" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="p6-semantic" value="Semantic&#xa;稳定事实与概念摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=12;" vertex="1" parent="p6-memory"><mxGeometry x="845" y="65" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="p6-procedural" value="Procedural&#xa;经过验证的策略与案例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p6-memory"><mxGeometry x="1115" y="65" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="p6-scope" value="可见范围与成熟阶段正交&#xa;public ｜ tenant ｜ agent-private ｜ user-private ｜ session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p6-1"><mxGeometry x="170" y="620" width="550" height="95" as="geometry"/></mxCell>
        <mxCell id="p6-compress" value="多层压缩与整理&#xa;访问频率 × 时间衰减 × 情感/业务强度 × 独特性 × 任务效用 × 可信度&#xa;隐私、同意、删除与保留策略拥有最高优先级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p6-1"><mxGeometry x="805" y="610" width="625" height="115" as="geometry"/></mxCell>
        <mxCell id="p6-multi" value="多模态证据：Asset + ExtractedText/Embedding + 精确 Locator + Lineage；关键结论回看原始区域，OCR/ASR/视觉描述都视为可纠错派生数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p6-1"><mxGeometry x="230" y="800" width="1140" height="90" as="geometry"/></mxCell>
        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p6-1" source="p6-query" target="p6-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p6-1" source="p6-auth" target="p6-rewrite"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p6-1" source="p6-rewrite" target="p6-retrieve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p6-1" source="p6-retrieve" target="p6-aggregate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p6-1" source="p6-aggregate" target="p6-evidence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6-e6" value="授权检索" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p6-1" source="p6-retrieve" target="p6-memory"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="v3-roadmap" name="07-实施路线">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p7-0"/><mxCell id="p7-1" parent="p7-0"/>
        <mxCell id="p7-title" value="建造脉络：先契约和确定性闭环，再接模型、记忆与动态工具" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p7-1"><mxGeometry x="210" y="25" width="1180" height="50" as="geometry"/></mxCell>
        <mxCell id="p7-m0" value="M0 契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=15;fontStyle=1;" vertex="1" parent="p7-1"><mxGeometry x="70" y="145" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m0d" value="JSON Schema / 状态机 / ADR&#xa;合同测试、非法转换、版本兼容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="p7-1"><mxGeometry x="310" y="130" width="1190" height="100" as="geometry"/></mxCell>
        <mxCell id="p7-m1" value="M1 事实层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=15;fontStyle=1;" vertex="1" parent="p7-1"><mxGeometry x="70" y="275" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m1d" value="PostgreSQL / Workflow / Outbox / Inbox / Artifact&#xa;验收：进程重启可恢复，重复消息不产生重复副作用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="p7-1"><mxGeometry x="310" y="260" width="1190" height="100" as="geometry"/></mxCell>
        <mxCell id="p7-m2" value="M2 + M2.1&#xa;闭环与治理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=15;fontStyle=1;" vertex="1" parent="p7-1"><mxGeometry x="70" y="405" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m2d" value="三个 Stub Agent + Admin Trace + 规范 / Loop Sentinel / 因果图 / 隔离&#xa;验收：闭环可追溯；循环、风暴、自委派与预算耗尽被确定性阻断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="p7-1"><mxGeometry x="310" y="390" width="1190" height="100" as="geometry"/></mxCell>
        <mxCell id="p7-m3" value="M3 插件闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=15;fontStyle=1;" vertex="1" parent="p7-1"><mxGeometry x="70" y="535" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m3d" value="worktree / Sandbox / Independent Gates / Canary / Rollback&#xa;验收：故障注入后恢复到 solar-energy@1.2.0 指定 Digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="p7-1"><mxGeometry x="310" y="520" width="1190" height="100" as="geometry"/></mxCell>
        <mxCell id="p7-m4" value="M4 模型闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=15;fontStyle=1;" vertex="1" parent="p7-1"><mxGeometry x="70" y="665" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m4d" value="pi-ai Model Gateway；先 Scientist，再 Director，最后 Engineer&#xa;验收：Provider 可替换；模型、Prompt、Tool、Knowledge Snapshot 可追溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="p7-1"><mxGeometry x="310" y="650" width="1190" height="100" as="geometry"/></mxCell>
        <mxCell id="p7-m5" value="M5 记忆工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=15;fontStyle=1;" vertex="1" parent="p7-1"><mxGeometry x="70" y="795" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m5d" value="授权检索 / SQL 聚合 / 长期记忆 / 异步工具 / 动态发现&#xa;验收：越权阻断、删除传播、长任务恢复和引用准确性测试通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="p7-1"><mxGeometry x="310" y="780" width="1190" height="100" as="geometry"/></mxCell>
        <mxCell id="p7-gate" value="每个里程碑都能独立演示与验收；上一阶段不可恢复、不可审计或不可回滚时，不进入下一阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p7-1"><mxGeometry x="280" y="920" width="1040" height="60" as="geometry"/></mxCell>
        <mxCell id="p7-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p7-1" source="p7-m0" target="p7-m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p7-1" source="p7-m1" target="p7-m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p7-1" source="p7-m2" target="p7-m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p7-1" source="p7-m3" target="p7-m4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p7-1" source="p7-m4" target="p7-m5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="v3-governance" name="08-联邦治理与循环防护">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p8-0"/><mxCell id="p8-1" parent="p8-0"/>
        <mxCell id="p8-title" value="联邦式三 Agent：执行可拆分，策略、预算与事实集中治理" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p8-1"><mxGeometry x="190" y="20" width="1220" height="50" as="geometry"/></mxCell>
        <mxCell id="p8-subtitle" value="Agent 只拥有能力与局部上下文；Control Plane 决定何时调度，Loop Sentinel 决定是否允许继续" style="text;html=1;align=center;fontSize=13;fontColor=#5E6C84;" vertex="1" parent="p8-1"><mxGeometry x="250" y="67" width="1100" height="35" as="geometry"/></mxCell>

        <mxCell id="p8-governance" value="集中治理平面（确定性平台能力，不是第四个 Agent）" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p8-1"><mxGeometry x="70" y="115" width="1460" height="195" as="geometry"/></mxCell>
        <mxCell id="p8-policy" value="规范与 Policy Snapshot&#xa;允许的委派 / 状态转换&#xa;风险与权限边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="p8-governance"><mxGeometry x="45" y="65" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="p8-dispatch" value="Control Plane&#xa;创建 Task / 校验 Result&#xa;审批与状态推进" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=12;fontStyle=1;" vertex="1" parent="p8-governance"><mxGeometry x="390" y="65" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="p8-sentinel" value="Loop Sentinel&#xa;Hop / Fingerprint / Budget&#xa;Cycle / Storm / Quarantine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;fontStyle=1;" vertex="1" parent="p8-governance"><mxGeometry x="735" y="65" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="p8-authority" value="Human + Release Authority&#xa;批准高风险计划&#xa;显式解除隔离 / 发布 / 回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;" vertex="1" parent="p8-governance"><mxGeometry x="1100" y="65" width="315" height="95" as="geometry"/></mxCell>

        <mxCell id="p8-agents" value="分布式执行平面（同进程合体或独立部署，契约不变）" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p8-1"><mxGeometry x="70" y="365" width="1460" height="205" as="geometry"/></mxCell>
        <mxCell id="p8-director" value="Learning Director&#xa;业务编排与用户沟通&#xa;不改代码，不批准发布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p8-agents"><mxGeometry x="105" y="65" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="p8-scientist" value="Learning Scientist&#xa;证据聚合、诊断与复评&#xa;不直接发布策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p8-agents"><mxGeometry x="570" y="65" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="p8-engineer" value="Experience Engineer&#xa;实现已批准的 ChangeSet&#xa;不改门禁，不自审自批" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p8-agents"><mxGeometry x="1035" y="65" width="320" height="105" as="geometry"/></mxCell>

        <mxCell id="p8-ledger" value="PostgreSQL 唯一事实源与不可变治理证据" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p8-1"><mxGeometry x="70" y="630" width="1460" height="185" as="geometry"/></mxCell>
        <mxCell id="p8-workflow" value="workflow_task&#xa;Task / Lease / Checkpoint&#xa;Parent / Hop / Epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p8-ledger"><mxGeometry x="35" y="62" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="p8-causal" value="causal_edge&#xa;Task / Event / Artifact 血缘&#xa;递归 CTE 检测环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p8-ledger"><mxGeometry x="390" y="62" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="p8-budget" value="run_budget_usage&#xa;Tasks / Transitions / Tokens&#xa;事务内锁定与消耗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p8-ledger"><mxGeometry x="745" y="62" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="p8-incident" value="sentinel_incident + quarantine&#xa;去重计数 / 动作 / 原因&#xa;Agent 或 Run 隔离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;" vertex="1" parent="p8-ledger"><mxGeometry x="1100" y="62" width="315" height="90" as="geometry"/></mxCell>

        <mxCell id="p8-rule" value="三层防护：契约规范预防 → Loop Sentinel 运行时阻断 → 因果与事件记录审计恢复；Agent 之间没有绕过 Control Plane 的正式直连通道" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p8-1"><mxGeometry x="220" y="875" width="1160" height="70" as="geometry"/></mxCell>

        <mxCell id="p8-e1" value="active policy" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p8-governance" source="p8-policy" target="p8-sentinel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p8-e2" value="pre-dispatch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p8-governance" source="p8-dispatch" target="p8-sentinel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p8-e3" value="authority" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#D97706;" edge="1" parent="p8-governance" source="p8-sentinel" target="p8-authority"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p8-e4" value="Governed Task" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p8-1" source="p8-governance" target="p8-agents"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p8-e5" value="Event / Result / ArtifactRef" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p8-1" source="p8-agents" target="p8-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-model-gateway" name="09-M4模型网关与信任边界">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p9-0"/><mxCell id="p9-1" parent="p9-0"/>
        <mxCell id="p9-title" value="M4 Model Gateway：模型只提供建议，治理与副作用仍由平台掌握" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p9-1"><mxGeometry x="180" y="25" width="1240" height="50" as="geometry"/></mxCell>

        <mxCell id="p9-control" value="Control Plane / Governed Task&#xa;deadline · cancellation · token/cost/duration budget&#xa;PostgreSQL 是唯一工作流事实源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p9-1"><mxGeometry x="500" y="95" width="600" height="95" as="geometry"/></mxCell>

        <mxCell id="p9-agents" value="Agent 信任边界" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p9-1"><mxGeometry x="60" y="235" width="390" height="430" as="geometry"/></mxCell>
        <mxCell id="p9-director" value="Learning Director（模型 + Stub）&#xa;模型：五阶段指导&#xa;代码绑定：Mission / PluginExposure / Canary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p9-agents"><mxGeometry x="35" y="65" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="p9-scientist" value="Learning Scientist（模型 + Stub）&#xa;模型：证据解释&#xa;代码绑定：Finding ID / Scope / Evidence / No-harm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="p9-agents"><mxGeometry x="35" y="185" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="p9-engineer" value="Experience Engineer（模型 + Stub）&#xa;模型：批准路径内 PatchProposal&#xa;平台：Source Digest → Worktree → Commit → Sandbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;" vertex="1" parent="p9-agents"><mxGeometry x="35" y="305" width="320" height="90" as="geometry"/></mxCell>

        <mxCell id="p9-gateway" value="packages/model-gateway" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=15;fontStyle=1;" vertex="1" parent="p9-1"><mxGeometry x="500" y="235" width="600" height="430" as="geometry"/></mxCell>
        <mxCell id="p9-route" value="Workload Router&#xa;有序主模型 / 后备模型&#xa;稳定 Routing Snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="p9-gateway"><mxGeometry x="35" y="65" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="p9-budget" value="Budget + Resilience&#xa;Token / Cost 预检与后检&#xa;Retry / Timeout / Cancel&#xa;流式仅首 delta 前 fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;" vertex="1" parent="p9-gateway"><mxGeometry x="320" y="65" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="p9-snapshots" value="Immutable Execution Evidence&#xa;Model + Routing + Prompt&#xa;Tool + Knowledge Snapshot&#xa;Usage + Latency + Route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p9-gateway"><mxGeometry x="35" y="205" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p9-no-tools" value="No Tool Side Effects&#xa;不传 tools 给 pi-ai&#xa;拒绝 model tool call&#xa;严格 JSON → 可信字段绑定 → Contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;" vertex="1" parent="p9-gateway"><mxGeometry x="320" y="205" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p9-ports" value="Provider-neutral ports：generate · stream · embed · rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=12;fontStyle=1;" vertex="1" parent="p9-gateway"><mxGeometry x="95" y="345" width="410" height="55" as="geometry"/></mxCell>

        <mxCell id="p9-providers" value="Provider 适配层" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p9-1"><mxGeometry x="1150" y="235" width="390" height="430" as="geometry"/></mxCell>
        <mxCell id="p9-piai" value="@earendil-works/pi-ai@0.83.0&#xa;generate / stream&#xa;统一模型目录、Provider 与认证解析&#xa;凭据不进入快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="p9-providers"><mxGeometry x="35" y="70" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="p9-llms" value="多模型 Provider&#xa;Anthropic / OpenAI / Google / DeepSeek / ...&#xa;模型与顺序由 workload 配置决定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p9-providers"><mxGeometry x="35" y="220" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="p9-extra" value="独立 Embedding / Rerank Provider&#xa;pi-ai 当前不提供，未配置时 fail closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;" vertex="1" parent="p9-providers"><mxGeometry x="35" y="340" width="320" height="60" as="geometry"/></mxCell>

        <mxCell id="p9-platform" value="确定性平台门禁（模型不可绕过）&#xa;Loop Sentinel · Approval · Artifact ACL · Git Worktree · Docker Sandbox · Release State Machine · Canary / Rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p9-1"><mxGeometry x="210" y="750" width="1180" height="95" as="geometry"/></mxCell>
        <mxCell id="p9-rule" value="M4 已完成：三个模型 Worker 均只能提出结构化建议；可信代码绑定身份与证据，Engineer 的真实 Commit 和门禁由隔离工程工具产生，发布仍需独立审批" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p9-1"><mxGeometry x="300" y="885" width="1000" height="60" as="geometry"/></mxCell>

        <mxCell id="p9-e1" value="Task" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p9-1" source="p9-control" target="p9-agents"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p9-e2" value="GenerationRequest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p9-1" source="p9-agents" target="p9-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p9-e3" value="Provider call" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#4C78A8;" edge="1" parent="p9-1" source="p9-gateway" target="p9-providers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p9-e4" value="validated AgentResult" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p9-1" source="p9-agents" target="p9-platform"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-invocation" name="10-M5模型调用投影与观测边界">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p10-0"/><mxCell id="p10-1" parent="p10-0"/>
        <mxCell id="p10-title" value="M5 Model Invocation Projection: every provider attempt is observable, raw prompts stay out of the ledger" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p10-1"><mxGeometry x="120" y="25" width="1360" height="55" as="geometry"/></mxCell>
        <mxCell id="p10-gateway" value="RoutedModelGateway" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=15;fontStyle=1;" vertex="1" parent="p10-1"><mxGeometry x="70" y="140" width="500" height="480" as="geometry"/></mxCell>
        <mxCell id="p10-attempt" value="Provider attempt&#xa;route + provider + model&#xa;attempt number + latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p10-gateway"><mxGeometry x="45" y="75" width="410" height="95" as="geometry"/></mxCell>
        <mxCell id="p10-result" value="Success / failure&#xa;usage: tokens + cost&#xa;error code + retryable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p10-gateway"><mxGeometry x="45" y="205" width="410" height="95" as="geometry"/></mxCell>
        <mxCell id="p10-snapshot" value="Snapshot IDs only&#xa;prompt / tools / knowledge&#xa;model + routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p10-gateway"><mxGeometry x="45" y="335" width="410" height="95" as="geometry"/></mxCell>
        <mxCell id="p10-observer" value="ModelInvocationObserver&#xa;optional port&#xa;telemetry failure cannot change workflow semantics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p10-1"><mxGeometry x="675" y="235" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="p10-db" value="PostgreSQL projection&#xa;questlab.model_invocation&#xa;idempotent request/attempt key&#xa;append-oriented audit records" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p10-1"><mxGeometry x="1100" y="140" width="400" height="480" as="geometry"/></mxCell>
        <mxCell id="p10-table" value="Indexes&#xa;workload + time&#xa;provider + status&#xa;request + attempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p10-db"><mxGeometry x="40" y="95" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="p10-aggregate" value="ModelInvocationRepository.aggregate()&#xa;calls / tokens / cost / average latency&#xa;workload + provider + status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p10-db"><mxGeometry x="40" y="260" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="p10-boundary" value="Trust boundary&#xa;projection is not workflow truth&#xa;no raw prompt, secret or generated text&#xa;RAG / memory may consume metrics, never mutate release state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p10-1"><mxGeometry x="300" y="720" width="1000" height="105" as="geometry"/></mxCell>
        <mxCell id="p10-e1" value="record per attempt" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p10-1" source="p10-gateway" target="p10-observer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10-e2" value="persist" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p10-1" source="p10-observer" target="p10-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10-e3" value="aggregate query" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p10-1" source="p10-db" target="p10-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-dynamic-retrieval" name="11-M5动态TopK与结构化聚合">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p11-0"/><mxCell id="p11-1" parent="p11-0"/>
        <mxCell id="p11-title" value="M5 Dynamic TopK: structured aggregation computes facts, RAG supplies bounded evidence" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p11-1"><mxGeometry x="120" y="25" width="1360" height="55" as="geometry"/></mxCell>
        <mxCell id="p11-query" value="Original query + intent&#xa;fact / count / comparison / multi-hop / temporal / multimodal&#xa;ACL and tenant scope are mandatory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p11-1"><mxGeometry x="70" y="135" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="p11-plan" value="Retrieval Planner&#xa;candidate_k -> fusion_k -> rerank_k -> context_k&#xa;Token budget / Agent / entity count&#xa;min K + score floor + marginal gain stop" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p11-1"><mxGeometry x="445" y="115" width="430" height="220" as="geometry"/></mxCell>
        <mxCell id="p11-retrievers" value="Parallel retrievers&#xa;BM25 / Vector / Graph / Temporal / Multimodal&#xa;ACL filter before context composition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p11-plan"><mxGeometry x="35" y="75" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="p11-aggregate" value="Structured Aggregator&#xa;count / distinct / time window / comparison / path&#xa;allowlisted read-only SQL or graph template&#xa;complete result, IDs and exclusion reasons" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p11-1"><mxGeometry x="970" y="115" width="470" height="220" as="geometry"/></mxCell>
        <mxCell id="p11-result" value="Structured result&#xa;事实值 + included IDs + conflicts&#xa;RAG is evidence support only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p11-aggregate"><mxGeometry x="45" y="75" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="p11-selection" value="Evidence selector&#xa;score floor / marginal gain&#xa;source and entity diversity&#xa;token cap / citation coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p11-1"><mxGeometry x="445" y="430" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="p11-pack" value="EvidencePack&#xa;structured_result + bounded evidence&#xa;coverage + conflicts + citation_required&#xa;Agent receives a package, never an unbounded Chunk list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p11-1"><mxGeometry x="970" y="430" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="p11-boundary" value="安全边界：固定上下限，动态实际 K；聚合问题不允许模型从 TopK 片段自行计数；任何缓存和索引都必须重新执行 ACL 校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p11-1"><mxGeometry x="220" y="700" width="1160" height="95" as="geometry"/></mxCell>
        <mxCell id="p11-e1" value="plan" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p11-1" source="p11-query" target="p11-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p11-e2" value="structured query when required" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p11-1" source="p11-plan" target="p11-aggregate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p11-e3" value="select evidence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p11-1" source="p11-plan" target="p11-selection"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p11-e4" value="compose" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p11-1" source="p11-selection" target="p11-pack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p11-e5" value="result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p11-1" source="p11-aggregate" target="p11-pack"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-memory-facts" name="12-M5记忆ACL与结构化聚合事实层">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p12-0"/><mxCell id="p12-1" parent="p12-0"/>
        <mxCell id="p12-title" value="M5 Memory Fact Layer: ACL is enforced before retrieval, aggregation is deterministic" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p12-1"><mxGeometry x="120" y="25" width="1360" height="55" as="geometry"/></mxCell>
        <mxCell id="p12-write" value="Capture / Structure&#xa;MemoryRecord metadata + source refs&#xa;raw content remains in object storage&#xa;stage: raw -> episodic -> structured" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p12-1"><mxGeometry x="70" y="125" width="410" height="300" as="geometry"/></mxCell>
        <mxCell id="p12-record" value="memory_record&#xa;tenant / owner / scope / stage&#xa;digest / confidence / sensitivity&#xa;active / deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p12-write"><mxGeometry x="35" y="75" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="p12-acl" value="memory_acl&#xa;user / agent / tenant / role / session&#xa;read / write / delete&#xa;explicit grants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p12-write"><mxGeometry x="35" y="220" width="340" height="65" as="geometry"/></mxCell>
        <mxCell id="p12-gateway" value="Retrieval Gateway&#xa;Principal + tenant + allowed scopes&#xa;Scope / owner / ACL filter&#xa;active-only and limit" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p12-1"><mxGeometry x="570" y="125" width="410" height="300" as="geometry"/></mxCell>
        <mxCell id="p12-readable" value="listReadable()&#xa;public / tenant / user_private&#xa;agent_private / session&#xa;ACL cannot be relaxed by Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p12-gateway"><mxGeometry x="35" y="85" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="p12-event" value="structured_event&#xa;dedupe_key + source_memory_ids&#xa;visibility copied from sources&#xa;broader scope rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p12-gateway"><mxGeometry x="35" y="230" width="340" height="55" as="geometry"/></mxCell>
        <mxCell id="p12-aggregate" value="Allowlisted Aggregator&#xa;COUNT DISTINCT dedupe_key&#xa;subject / event type / time range&#xa;returns value + included_event_ids" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p12-1"><mxGeometry x="1070" y="125" width="430" height="300" as="geometry"/></mxCell>
        <mxCell id="p12-result" value="Deterministic result&#xa;structured_result.value&#xa;included IDs / conflict count&#xa;RAG only adds citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p12-aggregate"><mxGeometry x="40" y="90" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="p12-boundary" value="安全边界：公共知识可跨租户读取；私有记忆必须匹配 owner 或 ACL；删除/归档记录不参与检索；模型不得从 TopK Chunk 自行完成精确计数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p12-1"><mxGeometry x="180" y="570" width="1240" height="105" as="geometry"/></mxCell>
        <mxCell id="p12-e1" value="capture" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p12-1" source="p12-write" target="p12-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p12-e2" value="authorized evidence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p12-1" source="p12-gateway" target="p12-aggregate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p12-e3" value="EvidencePack" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p12-1" source="p12-aggregate" target="p12-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
