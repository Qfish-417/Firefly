        <mxCell id="p23-r2a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p23-1" source="p23-router" target="p23-lexical"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-r2b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p23-1" source="p23-router" target="p23-vector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-r2c" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p23-1" source="p23-router" target="p23-hybrid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-r3a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p23-1" source="p23-lexical" target="p23-hits"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-r3b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p23-1" source="p23-vector" target="p23-hits"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-r3c" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p23-1" source="p23-hybrid" target="p23-hits"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p23-gate-band" value="One immutable run, three independent checks, one activation boundary" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="45" y="705" width="1510" height="245" as="geometry"/></mxCell>
        <mxCell id="p23-probes" value="ACL / Recall / Citation&#xa;shared result set&#xa;independent thresholds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="170" y="780" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="p23-report" value="IndexQualityReport&#xa;same Artifact evidence&#xa;any failure blocks activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="650" y="780" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="p23-active" value="Atomic activation&#xa;building -> active&#xa;evaluation path closes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="1130" y="780" width="300" height="110" as="geometry"/></mxCell>
