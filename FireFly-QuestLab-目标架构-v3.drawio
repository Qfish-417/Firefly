  <diagram id="v3-conversation-chunker" name="25-M5.9 Conversation Turn Chunker">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p25-0"/><mxCell id="p25-1" parent="p25-0"/>
        <mxCell id="p25-title" value="M5.9 Conversation Turn Chunker: preserve attribution and temporal context" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p25-1"><mxGeometry x="100" y="20" width="1400" height="50" as="geometry"/></mxCell>
