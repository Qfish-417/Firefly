  <diagram id="v3-governed-http-reranker" name="40-M5.27 Governed HTTP Reranker">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p40-0"/><mxCell id="p40-1" parent="p40-0"/>
        <mxCell id="p40-title" value="M5.27 Governed reranking: dynamic TopK after ACL, before evidence selection" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p40-1"><mxGeometry x="80" y="20" width="1440" height="50" as="geometry"/></mxCell>
        <mxCell id="p40-recall" value="Parallel recall&#xa;lexical | vector | graph | temporal&#xa;candidate_k per retriever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="55" y="130" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="p40-fusion" value="RRF fusion + dedupe&#xa;stable fused identities&#xa;fusion_k bound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="405" y="130" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="p40-acl" value="Memory authorization&#xa;tenant / user / Agent / session&#xa;deny before external disclosure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="755" y="130" width="320" height="145" as="geometry"/></mxCell>
        <mxCell id="p40-window" value="Dynamic rerank window&#xa;authorized.slice(0, plan.rerank_k)&#xa;query + ordered text only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="1135" y="130" width="360" height="145" as="geometry"/></mxCell>
        <mxCell id="p40-provider" value="HttpRerankerProvider / RerankPort&#xa;fixed HTTPS | no redirects or URL credentials&#xa;timeout | response bytes | document limit&#xa;separate from pi-ai generate/stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="1030" y="400" width="430" height="190" as="geometry"/></mxCell>
        <mxCell id="p40-validation" value="Two-layer response validation&#xa;exact count | unique in-range indexes&#xa;normalized score 0..1 | usage budget&#xa;cannot add IDs, duplicate or widen ACL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="540" y="400" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="p40-policy" value="Failure policy&#xa;retryable outage: deterministic RRF fallback&#xa;strict mode: fail closed&#xa;protocol / identity / budget: always fail closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="95" y="410" width="370" height="175" as="geometry"/></mxCell>
        <mxCell id="p40-select" value="Evidence selection + expansion&#xa;score / diversity / context token budget&#xa;Parent expansion then final ACL recheck&#xa;EvidencePack citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p40-1"><mxGeometry x="530" y="730" width="480" height="170" as="geometry"/></mxCell>
        <mxCell id="p40-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p40-1" source="p40-recall" target="p40-fusion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p40-1" source="p40-fusion" target="p40-acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p40-1" source="p40-acl" target="p40-window"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p40-1" source="p40-window" target="p40-provider"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p40-1" source="p40-provider" target="p40-validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p40-1" source="p40-validation" target="p40-policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p40-1" source="p40-validation" target="p40-select"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p40-1" source="p40-policy" target="p40-select"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p40-boundary" value="Boundary: reranking may reorder only the already-authorized dynamic window. It cannot retrieve new content, establish structured truth, execute tools or bypass final evidence budgets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p40-1"><mxGeometry x="180" y="935" width="1240" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
