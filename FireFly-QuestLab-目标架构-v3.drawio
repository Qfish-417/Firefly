        <mxCell id="p24-boundary" value="Boundary: parser provenance and structure are part of the build input. Any parser/model change requires a new source watermark or configuration Digest and a new quality report." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p24-1"><mxGeometry x="260" y="910" width="1080" height="35" as="geometry"/></mxCell>
