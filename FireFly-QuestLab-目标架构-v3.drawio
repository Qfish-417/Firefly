        <mxCell id="p23-g2" value="passed only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p23-1" source="p23-report" target="p23-active"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-boundary" value="Current boundary: exact pgvector evaluation, not production ANN latency or recall. Rerank quality, multilingual calibration and alternative hybrid weights require separately versioned evaluation contracts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p23-1"><mxGeometry x="310" y="905" width="980" height="30" as="geometry"/></mxCell>
