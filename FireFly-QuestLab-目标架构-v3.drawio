        <mxCell id="p4-web" value="Learner Web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p4-entry"><mxGeometry x="150" y="55" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="p4-admin" value="Teacher / Admin Console" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p4-entry"><mxGeometry x="600" y="55" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="p4-api" value="Public API / WebSocket / SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p4-entry"><mxGeometry x="1040" y="55" width="270" height="50" as="geometry"/></mxCell>
        <mxCell id="p4-core" value="QuestLab Core（同进程模块，独立数据所有权与端口）" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p4-1"><mxGeometry x="70" y="275" width="1460" height="250" as="geometry"/></mxCell>
        <mxCell id="p4-runtime" value="Learning Runtime&#xa;确定性业务状态机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p4-core"><mxGeometry x="40" y="75" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-control" value="Control Plane + Governance&#xa;Workflow / Policy / Sentinel / Approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p4-core"><mxGeometry x="300" y="75" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-agent" value="Agent Bundles&#xa;Director / Scientist / Engineer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p4-core"><mxGeometry x="560" y="75" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-model" value="Model Gateway&#xa;pi-ai / Route / Budget / Audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p4-core"><mxGeometry x="840" y="75" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-tools" value="Tool + Memory + Plugin Ports&#xa;统一授权与契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p4-core"><mxGeometry x="1110" y="75" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-workers" value="隔离执行层" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p4-1"><mxGeometry x="70" y="565" width="760" height="190" as="geometry"/></mxCell>
        <mxCell id="p4-sandbox" value="Sandbox Runner&#xa;worktree / container / network policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;" vertex="1" parent="p4-workers"><mxGeometry x="35" y="65" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-replay" value="Replay / Evaluation&#xa;固定 Dataset 与 Invariant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;" vertex="1" parent="p4-workers"><mxGeometry x="275" y="65" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-python" value="Python Analytics&#xa;仅统计与科学计算需要时引入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;" vertex="1" parent="p4-workers"><mxGeometry x="515" y="65" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-data" value="事实与制品层" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=14;fontStyle=1;" vertex="1" parent="p4-1"><mxGeometry x="870" y="565" width="660" height="190" as="geometry"/></mxCell>
        <mxCell id="p4-pg" value="PostgreSQL + pgvector&#xa;事实 / Workflow / Causal Graph&#xa;Budget / Incident / Outbox / Inbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;fontStyle=1;" vertex="1" parent="p4-data"><mxGeometry x="40" y="65" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-art" value="Git / Object / OCI Registry&#xa;Commit / Evidence / Digest / SBOM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="p4-data"><mxGeometry x="350" y="65" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-scale" value="拆分触发条件：权限隔离、独立扩缩容、故障域或吞吐出现真实需求；Transport Adapter 可从进程内调用切到队列/HTTP，领域契约不变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p4-1"><mxGeometry x="250" y="825" width="1100" height="80" as="geometry"/></mxCell>
        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="p4-1" source="p4-entry" target="p4-core"><mxGeometry relative="1" as="geometry"/></mxCell>
