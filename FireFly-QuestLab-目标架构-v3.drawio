        <mxCell id="p24-parent" value="Governed Parent/Child contract&#xa;Parent: context, no embedding&#xa;Child: recall unit, deterministic ordinal and identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="p24-1"><mxGeometry x="440" y="535" width="530" height="130" as="geometry"/></mxCell>
