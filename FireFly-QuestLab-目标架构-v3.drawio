        <mxCell id="p39-boundary" value="Boundary: the graph provider may change, but ACL filtering, explicit as_of, hop/size bounds, provenance deletion, conflict visibility and typed path evidence cannot be bypassed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p39-1"><mxGeometry x="170" y="935" width="1260" height="40" as="geometry"/></mxCell>
