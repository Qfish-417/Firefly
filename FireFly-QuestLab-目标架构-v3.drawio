        <mxCell id="p23-snapshot" value="Vector/Hybrid snapshot&#xa;query_embedding&#xa;embedding_model + dimension" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="470" y="145" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="p23-canonical" value="Canonical JSON + SHA-256&#xa;any query vector/model change&#xa;creates a new Digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p23-1"><mxGeometry x="850" y="145" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="p23-artifact" value="Immutable Evaluation Artifact&#xa;dataset identity + lineage&#xa;shared by all quality probes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="1230" y="145" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="p23-d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p23-1" source="p23-case" target="p23-snapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-d2" value="bind" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p23-1" source="p23-snapshot" target="p23-canonical"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23-d3" value="digest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p23-1" source="p23-canonical" target="p23-artifact"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p23-route-band" value="Building-only stage routing with the same tenant and Memory ACL" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="45" y="345" width="1510" height="325" as="geometry"/></mxCell>
        <mxCell id="p23-identity" value="Building identity gate&#xa;version / tenant / logical name&#xa;config Digest / source watermark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="70" y="445" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="p23-router" value="Stage router&#xa;model + dimension match&#xa;index-kind capability check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="420" y="445" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="p23-lexical" value="Lexical&#xa;PostgreSQL FTS&#xa;normalized rank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p23-1"><mxGeometry x="770" y="385" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="p23-vector" value="Vector&#xa;pgvector cosine&#xa;pinned query vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p23-1"><mxGeometry x="770" y="495" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="p23-hybrid" value="Hybrid&#xa;50% lexical + 50% vector&#xa;deterministic fused score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="770" y="605" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="p23-hits" value="Common citable hit contract&#xa;Chunk + Memory + score&#xa;Artifact Digest + locator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p23-1"><mxGeometry x="1160" y="445" width="300" height="120" as="geometry"/></mxCell>
