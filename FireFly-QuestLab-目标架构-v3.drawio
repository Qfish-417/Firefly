  <diagram id="v3-retrieval-contracts" name="14-M5版本化检索合同边界">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p14-0"/><mxCell id="p14-1" parent="p14-0"/>
        <mxCell id="p14-title" value="M5 Versioned Retrieval Contracts: validate on producer egress and consumer ingress" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p14-1"><mxGeometry x="120" y="25" width="1360" height="55" as="geometry"/></mxCell>
        <mxCell id="p14-contracts" value="@firefly/contracts v1" style="swimlane;html=1;horizontal=1;startSize=38;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=15;fontStyle=1;" vertex="1" parent="p14-1"><mxGeometry x="70" y="125" width="430" height="260" as="geometry"/></mxCell>
        <mxCell id="p14-types" value="Public vocabulary&#xa;QueryPlan / EvidencePack&#xa;StructuredResult / EvidenceItem&#xa;EvidenceCitation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p14-contracts"><mxGeometry x="35" y="70" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="p14-schema" value="One source boundary&#xa;TypeScript readonly types&#xa;JSON Schema Draft 2020-12&#xa;schema_version = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p14-contracts"><mxGeometry x="35" y="190" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="p14-gateway" value="Retrieval Gateway" style="swimlane;html=1;horizontal=1;startSize=38;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=15;fontStyle=1;" vertex="1" parent="p14-1"><mxGeometry x="585" y="125" width="430" height="260" as="geometry"/></mxCell>
        <mxCell id="p14-compose" value="Compose&#xa;stamp schema_version + query_id&#xa;attach deterministic result&#xa;bound untrusted evidence + trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p14-gateway"><mxGeometry x="35" y="70" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="p14-assert" value="Producer egress gate&#xa;assertContract(EvidencePack)&#xa;invalid Aggregator output fails closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p14-gateway"><mxGeometry x="35" y="190" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="p14-consumers" value="Replaceable consumers" style="swimlane;html=1;horizontal=1;startSize=38;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=15;fontStyle=1;" vertex="1" parent="p14-1"><mxGeometry x="1100" y="125" width="430" height="260" as="geometry"/></mxCell>
        <mxCell id="p14-agents" value="Learning Director&#xa;Learning Scientist&#xa;Experience Engineer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p14-consumers"><mxGeometry x="35" y="70" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="p14-ingress" value="Consumer ingress gate&#xa;repeat v1 Schema validation&#xa;then apply Agent Context Policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p14-consumers"><mxGeometry x="35" y="190" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="p14-input" value="Untrusted retrieval inputs&#xa;Retriever lists + Structured Aggregator result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p14-1"><mxGeometry x="70" y="500" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p14-plan" value="QueryPlan invariants&#xa;dynamic K has fixed bounds&#xa;structured intent requires structured stage&#xa;query identity remains explicit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p14-1"><mxGeometry x="450" y="500" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p14-pack" value="EvidencePack invariants&#xa;insufficient or conflict blocks generation&#xa;structured plan requires result&#xa;participating IDs are unique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p14-1"><mxGeometry x="830" y="500" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p14-citation" value="Evidence identity&#xa;content remains untrusted&#xa;citation URI + immutable SHA-256 Digest&#xa;locator preserves source position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p14-1"><mxGeometry x="1210" y="500" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="p14-boundary" value="拆分原则：合同归 contracts 包；规划器只计算；Gateway 负责组合与出站校验；远端消费者负责入站校验。内部网络、消息签名和 TypeScript 类型都不能替代运行时合同验证。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p14-1"><mxGeometry x="180" y="755" width="1240" height="105" as="geometry"/></mxCell>
        <mxCell id="p14-e1" value="shared types + schema" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p14-1" source="p14-contracts" target="p14-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p14-e2" value="validated v1 package" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p14-1" source="p14-gateway" target="p14-consumers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p14-e3" value="compose" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p14-1" source="p14-input" target="p14-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p14-e4" value="validate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p14-1" source="p14-plan" target="p14-pack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p14-e5" value="bind provenance" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p14-1" source="p14-pack" target="p14-citation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p14-e6" value="policy boundary" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p14-1" source="p14-pack" target="p14-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-postgres-retrieval" name="15-M5 PostgreSQL混合检索与删除传播">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p15-0"/><mxCell id="p15-1" parent="p15-0"/>
        <mxCell id="p15-title" value="M5 PostgreSQL Hybrid Retrieval: rebuildable indexes, double ACL, durable deletion propagation" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p15-1"><mxGeometry x="110" y="25" width="1380" height="55" as="geometry"/></mxCell>
        <mxCell id="p15-capture" value="Capture / Structure&#xa;active MemoryRecord&#xa;owner + scope + ACL&#xa;immutable source Digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="p15-1"><mxGeometry x="65" y="135" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="p15-indexer" value="PostgresMemoryIndexer&#xa;immutable Chunk ID&#xa;content + token count + entities&#xa;citation URI + Digest + locator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p15-1"><mxGeometry x="420" y="135" width="310" height="135" as="geometry"/></mxCell>
        <mxCell id="p15-chunk" value="questlab.memory_chunk" style="swimlane;html=1;horizontal=1;startSize=38;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=15;fontStyle=1;" vertex="1" parent="p15-1"><mxGeometry x="800" y="105" width="370" height="205" as="geometry"/></mxCell>
        <mxCell id="p15-projections" value="Generated tsvector + GIN&#xa;optional pgvector&#xa;embedding model + dimensions&#xa;rebuildable, never fact source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p15-chunk"><mxGeometry x="35" y="70" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="p15-ports" value="Retriever Ports&#xa;PostgreSQL FTS baseline&#xa;pgvector exact cosine&#xa;future BM25 / ANN adapters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p15-1"><mxGeometry x="1240" y="135" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="p15-query" value="RetrievalRequest&#xa;principal + purpose + filters&#xa;dynamic candidate K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p15-1"><mxGeometry x="65" y="445" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="p15-prefilter" value="Recall ACL predicate&#xa;tenant boundary + owner&#xa;explicit read grants&#xa;allowlisted filters only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;" vertex="1" parent="p15-1"><mxGeometry x="400" y="445" width="285" height="120" as="geometry"/></mxCell>
        <mxCell id="p15-final-auth" value="Final Authorization Port&#xa;re-read active Memory + ACL&#xa;verify Chunk / artifact / URI / Digest&#xa;index filter is not trusted alone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p15-1"><mxGeometry x="750" y="435" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="p15-gateway" value="Governed Gateway&#xa;RRF + selection + EvidencePack&#xa;contract validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p15-1"><mxGeometry x="1180" y="445" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="p15-delete" value="Authorized deleteMemory transaction&#xa;Memory tombstone + version&#xa;delete local Chunks&#xa;invalidate dependent Events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p15-1"><mxGeometry x="170" y="700" width="350" height="135" as="geometry"/></mxCell>
        <mxCell id="p15-receipt" value="Local deletion receipt&#xa;removed Chunk count&#xa;invalidated Event count&#xa;idempotent and auditable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p15-1"><mxGeometry x="625" y="700" width="320" height="135" as="geometry"/></mxCell>
        <mxCell id="p15-outbox" value="MemoryDeleted Outbox&#xa;external object store / BM25&#xa;cache / summary / evaluation derivatives&#xa;each consumer must acknowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p15-1"><mxGeometry x="1050" y="700" width="380" height="135" as="geometry"/></mxCell>
        <mxCell id="p15-note" value="边界说明：PostgreSQL FTS 不是 BM25；当前 pgvector 是按模型与维度过滤的精确搜索。生产 ANN 必须先按 Embedding 模型/维度分区。删除回执只代表本地事务完成，不能代替外部消费者确认。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p15-1"><mxGeometry x="250" y="890" width="1100" height="65" as="geometry"/></mxCell>
        <mxCell id="p15-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p15-1" source="p15-capture" target="p15-indexer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e2" value="index" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p15-1" source="p15-indexer" target="p15-chunk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e3" value="retrieve" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p15-1" source="p15-chunk" target="p15-ports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p15-1" source="p15-query" target="p15-prefilter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e5" value="mandatory predicate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p15-1" source="p15-prefilter" target="p15-ports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e6" value="authorized" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p15-1" source="p15-final-auth" target="p15-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e7" value="commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p15-1" source="p15-delete" target="p15-receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e8" value="propagate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p15-1" source="p15-receipt" target="p15-outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15-e9" value="ranked hits" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p15-1" source="p15-ports" target="p15-final-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-index-activation-deletion-ack" name="16-M5索引原子切换与删除完成确认">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p16-0"/><mxCell id="p16-1" parent="p16-0"/>
        <mxCell id="p16-title" value="M5 Atomic Index Activation and Verifiable Deletion Completion" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p16-1"><mxGeometry x="120" y="20" width="1360" height="55" as="geometry"/></mxCell>
        <mxCell id="p16-index-band" value="索引版本生命周期" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="45" y="95" width="1510" height="355" as="geometry"/></mxCell>
        <mxCell id="p16-build" value="IndexBuildTask v1&#xa;tenant + logical_name&#xa;config Digest + watermark&#xa;Embedding snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p16-1"><mxGeometry x="80" y="165" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p16-building" value="Build vN+1&#xa;status = building&#xa;Indexer 写入 version-bound Chunk&#xa;跨租户/模型/维度拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p16-1"><mxGeometry x="385" y="165" width="270" height="125" as="geometry"/></mxCell>
        <mxCell id="p16-ready" value="Ready Gate&#xa;result contract + counts&#xa;watermark + quality evidence&#xa;ready | failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="715" y="165" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p16-switch" value="Atomic switch&#xa;tenant/logical advisory lock&#xa;old active -> retired&#xa;new ready -> active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="1020" y="165" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p16-query" value="Query + final authorization&#xa;JOIN retrieval_index_version&#xa;私有同租户 active；public 可跨租户&#xa;vN+1 激活前始终读取 vN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="1315" y="155" width="210" height="145" as="geometry"/></mxCell>
        <mxCell id="p16-index-note" value="单一 active 指针决定正式流量；双读只能用于离线验证。旧版 Chunk 是可重建投影，按独立保留策略回收。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p16-1"><mxGeometry x="430" y="350" width="740" height="65" as="geometry"/></mxCell>
        <mxCell id="p16-ie1" value="persist" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p16-1" source="p16-build" target="p16-building"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p16-ie2" value="complete" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p16-1" source="p16-building" target="p16-ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p16-ie3" value="activate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p16-1" source="p16-ready" target="p16-switch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p16-ie4" value="active only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p16-1" source="p16-switch" target="p16-query"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p16-delete-band" value="删除传播与完成语义" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="45" y="495" width="1510" height="440" as="geometry"/></mxCell>
        <mxCell id="p16-local" value="Local delete transaction&#xa;Memory tombstone&#xa;删除本地 Chunk&#xa;失效来源 Event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="80" y="585" width="235" height="125" as="geometry"/></mxCell>
        <mxCell id="p16-receipt" value="Local receipt&#xa;传播目标为空 -> completed&#xa;存在外部目标 -> pending&#xa;保留本地计数与时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p16-1"><mxGeometry x="375" y="585" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p16-fanout" value="Per-target Outbox fan-out&#xa;object / lexical / vector&#xa;multimodal / cache / summary / eval&#xa;每个目标独立 pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p16-1"><mxGeometry x="680" y="575" width="275" height="145" as="geometry"/></mxCell>
        <mxCell id="p16-ack" value="DeletionPropagationAck v1&#xa;ack_id 幂等&#xa;attempt 单调递增&#xa;failed 可由更高 attempt 重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="1015" y="575" width="255" height="145" as="geometry"/></mxCell>
        <mxCell id="p16-global" value="Aggregate status&#xa;任一 failed -> failed&#xa;仍有 pending -> pending&#xa;全部 completed -> completed event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="1330" y="575" width="195" height="145" as="geometry"/></mxCell>
        <mxCell id="p16-boundary" value="安全边界：本地删除回执 != 全局删除完成。未请求目标、旧 attempt、冲突 Ack 一律 fail closed；Provider Ack 仍需证据核验与周期性 reconciliation。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p16-1"><mxGeometry x="245" y="825" width="1110" height="75" as="geometry"/></mxCell>
        <mxCell id="p16-de1" value="commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p16-1" source="p16-local" target="p16-receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p16-de2" value="tasks" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p16-1" source="p16-receipt" target="p16-fanout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p16-de3" value="ack" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p16-1" source="p16-fanout" target="p16-ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p16-de4" value="reduce" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p16-1" source="p16-ack" target="p16-global"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-memory-background-workers" name="17-M5.1后台Worker与MinIO删除闭环">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p17-0"/><mxCell id="p17-1" parent="p17-0"/>
        <mxCell id="p17-title" value="M5.1 Durable Background Workers: Index Build and MinIO/S3 Deletion" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p17-1"><mxGeometry x="100" y="20" width="1400" height="50" as="geometry"/></mxCell>

        <mxCell id="p17-index-band" value="索引构建泳道" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="45" y="85" width="1510" height="330" as="geometry"/></mxCell>
        <mxCell id="p17-index-outbox" value="RetrievalIndexBuildRequested&#xa;Outbox 定向领取&#xa;lease + bounded attempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="75" y="155" width="235" height="115" as="geometry"/></mxCell>
        <mxCell id="p17-source" value="IndexSourcePort&#xa;加载版本化文档&#xa;Citation + source Digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="360" y="155" width="225" height="115" as="geometry"/></mxCell>
        <mxCell id="p17-chunker" value="Deterministic Chunker&#xa;stable Chunk ID&#xa;paragraph baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="635" y="155" width="215" height="115" as="geometry"/></mxCell>
        <mxCell id="p17-embed" value="EmbeddingPort&#xa;Model Gateway 独立端口&#xa;count + dimension check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="900" y="155" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="p17-indexer" value="PostgresMemoryIndexer&#xa;幂等写 version-bound Chunk&#xa;building 版本不可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="1170" y="155" width="245" height="115" as="geometry"/></mxCell>
        <mxCell id="p17-ready" value="Ready Gate + atomic activate&#xa;结构完整才 ready&#xa;旧 active 在切换前继续服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="1125" y="315" width="335" height="75" as="geometry"/></mxCell>
        <mxCell id="p17-recovery" value="状态恢复：building 继续；ready 补激活；active/retired 完成；failed 停止。可重试错误指数退避，耗尽后记录 failed + discarded。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="220" y="315" width="760" height="75" as="geometry"/></mxCell>
        <mxCell id="p17-ie1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p17-1" source="p17-index-outbox" target="p17-source"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-ie2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p17-1" source="p17-source" target="p17-chunker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-ie3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p17-1" source="p17-chunker" target="p17-embed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-ie4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p17-1" source="p17-embed" target="p17-indexer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-ie5" value="complete" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p17-1" source="p17-indexer" target="p17-ready"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p17-delete-band" value="对象删除与修复泳道" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="45" y="445" width="1510" height="505" as="geometry"/></mxCell>
        <mxCell id="p17-delete-outbox" value="DeletionPropagationTask&#xa;resource_refs + target&#xa;按 target 定向领取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="75" y="525" width="235" height="120" as="geometry"/></mxCell>
        <mxCell id="p17-delete-worker" value="DeletionPropagationWorker&#xa;校验 tenant/memory/target&#xa;attempt 单调递增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="370" y="525" width="245" height="120" as="geometry"/></mxCell>
        <mxCell id="p17-s3-adapter" value="ObjectStoreDeletionConsumer&#xa;仅接受 s3:// 引用&#xa;bucket/key 去重 + AWS SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="675" y="525" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="p17-minio" value="MinIO / S3&#xa;DeleteObject&#xa;Provider side effect" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="1000" y="525" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="p17-ack" value="DeletionPropagationAck&#xa;completed | failed&#xa;全目标完成才全局完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="1270" y="525" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="p17-backoff" value="Provider 失败&#xa;failed Ack + exponential backoff&#xa;attempt 耗尽 -> discarded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="260" y="710" width="315" height="105" as="geometry"/></mxCell>
        <mxCell id="p17-reconcile" value="Reconciliation&#xa;扫描 stale failed target&#xa;行锁复核 + 幂等新任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="650" y="710" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="p17-boundary" value="关键崩溃边界：Provider 删除失败 != Ack / 数据库 / markPublished 失败。completed Ack 已提交但发布失败时，重放只补发布；不得反写 failed Ack，也不得篡改已经完成的删除事实。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p17-1"><mxGeometry x="1010" y="700" width="500" height="125" as="geometry"/></mxCell>
        <mxCell id="p17-next" value="后续：reconciliation 周期调度与告警、Provider 证据核验、其他删除目标、retired index GC、ACL/Recall/Citation 高级 Ready Gate。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p17-1"><mxGeometry x="285" y="865" width="1030" height="60" as="geometry"/></mxCell>
        <mxCell id="p17-de1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p17-1" source="p17-delete-outbox" target="p17-delete-worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-de2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p17-1" source="p17-delete-worker" target="p17-s3-adapter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-de3" value="delete" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p17-1" source="p17-s3-adapter" target="p17-minio"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-de4" value="evidence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p17-1" source="p17-minio" target="p17-ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-de5" value="retryable" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;dashed=1;" edge="1" parent="p17-1" source="p17-delete-worker" target="p17-backoff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-de6" value="stale failed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;dashed=1;" edge="1" parent="p17-1" source="p17-backoff" target="p17-reconcile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17-de7" value="fresh task" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;dashed=1;" edge="1" parent="p17-1" source="p17-reconcile" target="p17-delete-outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-index-quality-gate" name="18-M5.2可审计索引质量门禁">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p18-0"/><mxCell id="p18-1" parent="p18-0"/>
        <mxCell id="p18-title" value="M5.2 Auditable Index Quality Gate: evidence before activation" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p18-1"><mxGeometry x="120" y="20" width="1360" height="50" as="geometry"/></mxCell>

        <mxCell id="p18-input-band" value="不可变构建输入" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="45" y="90" width="1510" height="180" as="geometry"/></mxCell>
        <mxCell id="p18-task" value="IndexBuildTask v1&#xa;build_id + index_version_id&#xa;source_watermark&#xa;configuration Digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="90" y="145" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="p18-built" value="Building index projection&#xa;source documents + version-bound Chunks&#xa;Embedding snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="p18-1"><mxGeometry x="650" y="145" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="p18-evidence" value="Evaluation evidence&#xa;ACL samples + fixed query set&#xa;expected citations + ArtifactRef" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p18-1"><mxGeometry x="1210" y="145" width="300" height="100" as="geometry"/></mxCell>

        <mxCell id="p18-gate-band" value="AdvancedIndexReadyGate：五项检查必须齐全且名称唯一" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="45" y="305" width="1510" height="310" as="geometry"/></mxCell>
        <mxCell id="p18-structure" value="Structure&#xa;文档非空&#xa;每文档有 Chunk&#xa;ID / Embedding 一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="75" y="385" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p18-watermark" value="Source Watermark&#xa;当前水位 == 构建快照&#xa;变化即拒绝激活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="375" y="385" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p18-acl" value="ACL Probe&#xa;租户 / 用户 / Agent 抽样&#xa;越权召回必须为 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="675" y="385" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p18-recall" value="Recall Probe&#xa;固定评测集 + expected evidence&#xa;score &gt;= threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="975" y="385" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p18-citation" value="Citation Probe&#xa;URI / Digest / Locator 可解析&#xa;score &gt;= threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="1275" y="385" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p18-check-rule" value="每项输出：passed、score、threshold、sample_size、summary、evidence_refs。声明结果必须与 score/threshold 自洽；任一失败则整体失败。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p18-1"><mxGeometry x="285" y="545" width="1030" height="50" as="geometry"/></mxCell>

        <mxCell id="p18-report" value="IndexQualityReport v1&#xa;canonical checks -> stable report_id&#xa;绑定 build / version / watermark / config Digest&#xa;合同出站校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="145" y="680" width="360" height="145" as="geometry"/></mxCell>
        <mxCell id="p18-db" value="questlab.retrieval_index_version&#xa;quality_report JSONB&#xa;Repository 校验身份 + 幂等重放&#xa;报告随版本长期可审计" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="620" y="680" width="350" height="145" as="geometry"/></mxCell>
        <mxCell id="p18-activate" value="Atomic activation&#xa;report passed + build ready&#xa;old active -> retired&#xa;new version -> active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="1085" y="680" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="p18-boundary" value="Fail closed：缺 Probe、重复检查、非法分数、失败项、报告身份不匹配或状态矛盾均不可激活。当前已内置 Structure 与 Source Watermark；生产 ACL / Recall / Citation 适配器和固定评测集仍是部署前置条件。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="p18-1"><mxGeometry x="210" y="875" width="1180" height="75" as="geometry"/></mxCell>

        <mxCell id="p18-e1" value="evaluate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p18-1" source="p18-task" target="p18-structure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p18-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p18-1" source="p18-built" target="p18-acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p18-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p18-1" source="p18-evidence" target="p18-citation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p18-e4" value="aggregate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p18-1" source="p18-check-rule" target="p18-report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p18-e5" value="persist" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p18-1" source="p18-report" target="p18-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p18-e6" value="passed only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p18-1" source="p18-db" target="p18-activate"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-parent-child-expansion" name="19-M5.3 Parent-Child分块与授权扩展">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p19-0"/><mxCell id="p19-1" parent="p19-0"/>
        <mxCell id="p19-title" value="M5.3 Parent/Child Retrieval: precise recall, governed context expansion" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p19-1"><mxGeometry x="110" y="20" width="1380" height="50" as="geometry"/></mxCell>

        <mxCell id="p19-build-band" value="构建：结构上下文与召回粒度分离" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="45" y="85" width="1510" height="245" as="geometry"/></mxCell>
        <mxCell id="p19-source" value="Markdown Source&#xa;document version + Digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="85" y="155" width="235" height="100" as="geometry"/></mxCell>
        <mxCell id="p19-chunker" value="MarkdownParentChildChunker&#xa;标题层级 -> structure_path&#xa;stable ordinal + locator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="405" y="145" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="p19-parent" value="Parent Section&#xa;完整章节上下文&#xa;无 Embedding，不参与召回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="815" y="125" width="285" height="100" as="geometry"/></mxCell>
        <mxCell id="p19-child" value="Child Chunk&#xa;召回粒度内容 + parent_chunk_id&#xa;仅 Child 生成 Embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="815" y="235" width="285" height="80" as="geometry"/></mxCell>
        <mxCell id="p19-db" value="questlab.memory_chunk&#xa;同 Memory + 同 index version 父引用&#xa;Parent shape / FK / index constraints" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="1215" y="155" width="295" height="120" as="geometry"/></mxCell>
        <mxCell id="p19-be1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p19-1" source="p19-source" target="p19-chunker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-be2" value="section" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p19-1" source="p19-chunker" target="p19-parent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-be3" value="retrieval units" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p19-1" source="p19-chunker" target="p19-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-be4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p19-1" source="p19-parent" target="p19-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-be5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p19-1" source="p19-child" target="p19-db"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p19-recall-band" value="检索：只用 Child 召回，选择后才扩展" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="45" y="355" width="1510" height="275" as="geometry"/></mxCell>
        <mxCell id="p19-query" value="QueryPlan&#xa;dynamic candidate/fusion/context K&#xa;max_context_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="75" y="430" width="255" height="115" as="geometry"/></mxCell>
        <mxCell id="p19-retrievers" value="PostgreSQL Retrievers&#xa;FTS + pgvector&#xa;WHERE chunk_level = child" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="380" y="430" width="255" height="115" as="geometry"/></mxCell>
        <mxCell id="p19-fusion" value="RRF + Child authorization&#xa;active index + tenant + Memory ACL&#xa;immutable Evidence ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="685" y="430" width="285" height="115" as="geometry"/></mxCell>
        <mxCell id="p19-select" value="Evidence selection&#xa;score / diversity / dynamic K&#xa;Child token budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="1020" y="430" width="245" height="115" as="geometry"/></mxCell>
        <mxCell id="p19-expander" value="PostgresParentChildExpander&#xa;selected Child -> Parent&#xa;shared Parent dedup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="1315" y="430" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="p19-re1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p19-1" source="p19-query" target="p19-retrievers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-re2" value="Child hits" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p19-1" source="p19-retrievers" target="p19-fusion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-re3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p19-1" source="p19-fusion" target="p19-select"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-re4" value="selected Child" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p19-1" source="p19-select" target="p19-expander"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-re5" value="load parent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;dashed=1;" edge="1" parent="p19-1" source="p19-db" target="p19-expander"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p19-guard-band" value="扩展边界：重新授权、预算约束、失败关闭" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="45" y="655" width="1510" height="300" as="geometry"/></mxCell>
        <mxCell id="p19-recheck" value="Expanded evidence validation&#xa;active index + tenant + Memory ACL&#xa;Gateway 再次授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="150" y="735" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="p19-budget" value="Token budget gate&#xa;Parent fits -> replace Child&#xa;Parent too large -> keep Child" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="640" y="735" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="p19-pack" value="EvidencePack v1&#xa;authorized + deduplicated&#xa;budget bounded + citable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="p19-1"><mxGeometry x="1130" y="735" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="p19-boundary" value="Fail closed：跨 Memory / 跨索引版本父引用、非 active Parent、租户或 ACL 不匹配、Evidence ID 冲突、Expander 突破预算均被拒绝。当前结构化实现仅覆盖 Markdown；PDF、代码、表格与多模态 Chunker 后续接入。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p19-1"><mxGeometry x="250" y="890" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="p19-ge1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p19-1" source="p19-expander" target="p19-recheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-ge2" value="authorized" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p19-1" source="p19-recheck" target="p19-budget"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19-ge3" value="compose" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p19-1" source="p19-budget" target="p19-pack"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-fixed-index-evaluation" name="20-M5.4固定评测与Building索引门禁">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p20-0"/><mxCell id="p20-1" parent="p20-0"/>
        <mxCell id="p20-title" value="M5.4 Digest-bound Fixed Evaluation: measure the candidate before activation" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p20-1"><mxGeometry x="100" y="20" width="1400" height="50" as="geometry"/></mxCell>

        <mxCell id="p20-evidence-band" value="固定评测证据：改变内容必须改变 Digest" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="45" y="85" width="1510" height="225" as="geometry"/></mxCell>
        <mxCell id="p20-set" value="IndexEvaluationSet v1&#xa;lexical query + principal + TopK&#xa;expected / forbidden Memory&#xa;expected Citation + thresholds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="90" y="140" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="p20-canonical" value="Canonical JSON&#xa;stable object-key order&#xa;SHA-256 recomputation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p20-1"><mxGeometry x="545" y="150" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="p20-artifact" value="Evaluation ArtifactRef&#xa;immutable URI + Digest&#xa;tenant/public ownership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="950" y="150" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="p20-integrity" value="Integrity gate&#xa;payload Digest == Artifact Digest&#xa;logical name / tenant match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="1325" y="150" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="p20-ee1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p20-1" source="p20-set" target="p20-canonical"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-ee2" value="digest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p20-1" source="p20-canonical" target="p20-artifact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-ee3" value="verify" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p20-1" source="p20-artifact" target="p20-integrity"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p20-run-band" value="候选评测：专用通道读取 building 版本，正常 Retriever 仍只读 active" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="45" y="340" width="1510" height="280" as="geometry"/></mxCell>
        <mxCell id="p20-task" value="IndexBuildTask&#xa;version + tenant + logical name&#xa;config Digest + source watermark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="75" y="425" width="285" height="120" as="geometry"/></mxCell>
        <mxCell id="p20-building" value="PostgreSQL candidate index&#xa;status = building&#xa;Child FTS + real Memory ACL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="455" y="425" width="285" height="120" as="geometry"/></mxCell>
        <mxCell id="p20-evaluator" value="PostgresBuildingIndexQualityEvaluator&#xa;identity recheck&#xa;evaluation-only lexical search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="835" y="425" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="p20-runner" value="FixedIndexEvaluationRunner&#xa;one execution per build&#xa;shared immutable result set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="1260" y="425" width="255" height="120" as="geometry"/></mxCell>
        <mxCell id="p20-re1" value="bind" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p20-1" source="p20-task" target="p20-building"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-re2" value="authorized hits" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p20-1" source="p20-building" target="p20-evaluator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-re3" value="case results" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p20-1" source="p20-evaluator" target="p20-runner"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p20-score-band" value="独立计分与激活边界" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="45" y="650" width="1510" height="305" as="geometry"/></mxCell>
        <mxCell id="p20-acl" value="ACL Probe&#xa;forbidden Memory leakage = 0&#xa;score vs threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="90" y="730" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p20-recall" value="Recall Probe&#xa;expected Memory coverage&#xa;score vs threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="430" y="730" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p20-citation" value="Citation Probe&#xa;artifact + URI + Digest + locator&#xa;exact assertion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="770" y="730" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="p20-report" value="IndexQualityReport v1&#xa;three checks cite same Artifact&#xa;any failure blocks activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="1130" y="730" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="p20-active" value="Atomic activate&#xa;building -> active&#xa;evaluation-only path closes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p20-1"><mxGeometry x="1250" y="875" width="265" height="60" as="geometry"/></mxCell>
        <mxCell id="p20-boundary" value="当前边界：已验证 PostgreSQL lexical。vector / fused hybrid 评测必须绑定查询 Embedding 与模型快照后另行接入；lexical 通过不等于向量质量通过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="p20-1"><mxGeometry x="120" y="875" width="1000" height="60" as="geometry"/></mxCell>
        <mxCell id="p20-se1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p20-1" source="p20-runner" target="p20-acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-se2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p20-1" source="p20-runner" target="p20-recall"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-se3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p20-1" source="p20-runner" target="p20-citation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-se4a" value="ACL check" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p20-1" source="p20-acl" target="p20-report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-se4b" value="Recall check" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p20-1" source="p20-recall" target="p20-report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-se4c" value="Citation check" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p20-1" source="p20-citation" target="p20-report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20-se5" value="passed only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p20-1" source="p20-report" target="p20-active"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v3-deletion-reconciliation-scheduler" name="21-M5.5删除Reconciliation周期调度">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p21-0"/><mxCell id="p21-1" parent="p21-0"/>
        <mxCell id="p21-title" value="M5.5 Deletion Reconciliation: bounded recovery without duplicate side effects" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p21-1"><mxGeometry x="100" y="20" width="1400" height="50" as="geometry"/></mxCell>

        <mxCell id="p21-scan-band" value="Periodic trigger and bounded candidate selection" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="45" y="85" width="1510" height="245" as="geometry"/></mxCell>
        <mxCell id="p21-failed" value="Failed deletion targets&#xa;status = failed&#xa;updated_at watermark" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="90" y="150" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-scheduler" value="Periodic Scheduler&#xa;runOnce coalescing&#xa;one in-flight cycle per instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="455" y="150" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-window" value="Bounded scan window&#xa;stale cutoff&#xa;validated batch limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="845" y="150" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-candidates" value="Candidate scan&#xa;stale failed targets only&#xa;bounded result set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="1215" y="150" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-s1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p21-1" source="p21-failed" target="p21-scheduler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-s2" value="tick" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p21-1" source="p21-scheduler" target="p21-window"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-s3" value="query" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p21-1" source="p21-window" target="p21-candidates"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p21-tx-band" value="Per-target database transaction: concurrency safety belongs to durable state" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="45" y="365" width="1510" height="280" as="geometry"/></mxCell>
        <mxCell id="p21-lock" value="Row lock&#xa;serialize target mutation&#xa;across replicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="1280" y="445" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-recheck" value="State recheck&#xa;still failed?&#xa;otherwise no-op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="985" y="445" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-outbox" value="Deterministic Outbox retry&#xa;identity is idempotent&#xa;same transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="670" y="445" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-pending" value="Target pending&#xa;attempt increases&#xa;ready for reclaim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="375" y="445" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-worker" value="DeletionPropagationWorker&#xa;provider side effect&#xa;Ack completed | failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="80" y="445" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p21-t0" value="each target" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="p21-1" source="p21-candidates" target="p21-lock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="p21-1" source="p21-lock" target="p21-recheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t2" value="failed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="p21-1" source="p21-recheck" target="p21-outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t3" value="commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="p21-1" source="p21-outbox" target="p21-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21-t4" value="claim" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="p21-1" source="p21-pending" target="p21-worker"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p21-ops-band" value="Lifecycle and observability boundaries" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=15;fontStyle=1;" vertex="1" parent="p21-1"><mxGeometry x="45" y="680" width="1510" height="270" as="geometry"/></mxCell>
        <mxCell id="p21-observe" value="Structured cycle result&#xa;scheduler / instance / cycle&#xa;cutoff / limit / count / duration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="80" y="750" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-failure" value="Failure isolation&#xa;failed cycle is observable&#xa;next interval still runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="455" y="750" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-observer" value="Observer isolation&#xa;observer failure increments counter&#xa;database fact stays unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="810" y="750" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-shutdown" value="AbortSignal shutdown&#xa;no new cycle after cancellation&#xa;in-flight transaction completes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="p21-1"><mxGeometry x="1185" y="750" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="p21-boundary" value="Multi-replica rule: scheduler instances may scan concurrently; row lock + failed-state recheck + deterministic Outbox identity prevent duplicate durable work. Persistent run ledger, deployment alerts and provider evidence verification remain follow-up work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="p21-1"><mxGeometry x="210" y="895" width="1180" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
