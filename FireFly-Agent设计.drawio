          <mxGeometry x="40" y="100" width="740" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1043" value="机制：父 Agent 通过 task 工具派发 子 Agent 用独立 messages[] 跑完 只返回摘要文本给父 生命周期：生成→干活→返回→消亡  上下文：完全隔离（父只收摘要） 通信：无（单向返回） 适用：专项、独立、可并行的子任务 task 工具仅父端注册（防递归）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n1044" value="spawn_teammate 持久队友" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7B1FA2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="740" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1045" value="机制：父 Agent 派生持久线程，有身份和生命周期 跨多轮存活，直到显式 shutdown  上下文：隔离，各自维护 messages[] 通信：MessageBus 收件箱双向通信 适用：需跨多轮观察/协作的任务  关键：身份重注入(s11)、慢操作走BackgroundTask(s13)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontSize=11;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="135" width="740" height="180" as="geometry" />
