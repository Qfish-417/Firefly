        <mxCell id="n1135" value="4. patch_generator 派发patch_subagent生成补丁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="720" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1136" value="5. code_reviewer 派发reviewer_subagent审查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="720" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1137" value="6. test_runner worktree内跑全量测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="720" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1138" value="7. build_trigger docker build打镜像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1139" value="8. canary_controller 灰度5%→50%→100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="765" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1140" value="9. rollback_executor git revert+重建上一tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="765" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1141" value="10. nacos_config_push L1软升级热更配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="765" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1142" value="11. experience_writer 写成功/失败案例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="765" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1143" value="12. inbox_rw 持久收件箱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="765" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1144" value="L3 代码升级流水线（死锁式，任一失败回滚）" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2328;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="825" width="1520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n1145" value="消费改进点 → 判断level → L3: worktree开目录 → patch生成 → reviewer审查(最多3轮) → test全量 → build打镜像 → 人工approve → canary灰度5% → rollback_subagent观察 → 达标50%→100% / 退化git revert回滚+写失败案例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=10;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1146" value="worktree 隔离(s18)：每个改进任务一个独立 git worktree，多任务并行改码互不覆盖，24h未合并自动清理" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1520" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="图引擎DAG编排" id="p_graph">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="g1" value="图引擎 DAG 编排（升级 Agent 批量任务并行调度）" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="g2" value="一、Loop 引擎 vs 图引擎（DAG）—— 不是替代，是分层叠加" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="900" height="22" as="geometry"/></mxCell>
<mxCell id="g3" value="&lt;b&gt;Loop 引擎（现状）&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;while True 串行&lt;br/&gt;一个任务跑完才下一个&lt;br/&gt;每个 agent 一个大循环&lt;br/&gt;简单但慢，批量任务浪费并发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E6A23C;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="210" height="120" as="geometry"/></mxCell>
<mxCell id="g4" value="&lt;b&gt;图引擎 DAG（升级）&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;任务建依赖图&lt;br/&gt;无依赖节点&lt;b&gt;并行&lt;/b&gt;&lt;br/&gt;有依赖节点串行&lt;br/&gt;每节点内部仍是 loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#67C23A;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="210" height="120" as="geometry"/></mxCell>
<mxCell id="g5" value="&lt;b&gt;分层关系&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;图引擎 = 调度层&lt;br/&gt;loop 节点 = 执行层&lt;br/&gt;工具 = 底层能力&lt;br/&gt;三者共存不冲突" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4F9;strokeColor=#4A90D9;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="210" height="120" as="geometry"/></mxCell>
<mxCell id="eg6" value="形式化升级" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="eg7" value="分层" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g8" value="二、三层调度架构（图引擎不替代 loop，是 loop 的并行调度器）" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="900" height="22" as="geometry"/></mxCell>
<mxCell id="g9" value="&lt;b&gt;图引擎调度层（DAG Engine）&lt;/b&gt;　依赖分析 → 建图 → 拓扑排序 → 并发执行无依赖节点 → 故障隔离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#5B8DEF;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="280" width="640" height="50" as="geometry"/></mxCell>
<mxCell id="g10" value="&lt;b&gt;Loop 节点执行层&lt;/b&gt;　每节点 = 一个完整 loop 任务（如 L3 流水线：patch→review→test→build→灰度）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E6A23C;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="345" width="640" height="50" as="geometry"/></mxCell>
<mxCell id="g11" value="&lt;b&gt;工具层&lt;/b&gt;　worktree / patch_generator / test_runner / build_trigger / canary / rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4F9;strokeColor=#4A90D9;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="410" width="640" height="50" as="geometry"/></mxCell>
<mxCell id="eg12" value="调度节点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g9" target="g10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="eg13" value="调用工具" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g10" target="g11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g14" value="三、DAG 示例：升级 Agent 收到 4 个改进点，建依赖图后并行执行" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="900" height="22" as="geometry"/></mxCell>
<mxCell id="g15" value="&lt;b&gt;imp_001&lt;/b&gt;&lt;br/&gt;改 SeckillServiceImpl&lt;br/&gt;L3 流水线&lt;br/&gt;(loop 节点)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#67C23A;fontColor=#1F2329;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="g16" value="&lt;b&gt;imp_002&lt;/b&gt;&lt;br/&gt;改 OrderServiceImpl&lt;br/&gt;L3 流水线&lt;br/&gt;(loop 节点)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#67C23A;fontColor=#1F2329;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="520" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="g17" value="&lt;b&gt;imp_003&lt;/b&gt;&lt;br/&gt;改 UserServiceImpl&lt;br/&gt;L3 流水线&lt;br/&gt;(loop 节点)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#67C23A;fontColor=#1F2329;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="g18" value="&lt;b&gt;imp_004&lt;/b&gt;&lt;br/&gt;改 SeckillServiceImpl&lt;br/&gt;L3 流水线&lt;br/&gt;(loop 节点)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="g19" value="&lt;b&gt;全量回归验证&lt;/b&gt;&lt;br/&gt;(依赖全部完成)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#5B8DEF;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="620" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="eg20" value="同文件串行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g15" target="g18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="eg21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g15" target="g19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="eg22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g16" target="g19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="eg23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g17" target="g19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="eg24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888;endArrow=classic;fontColor=#1F2329;fontSize=9;" edge="1" parent="1" source="g18" target="g19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g25" value="↑ 并行执行" style="text;html=1;align=left;fontSize=10;fontColor=#666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="150" height="20" as="geometry"/></mxCell>
<mxCell id="g26" value="↑ 等 imp_001 完成" style="text;html=1;align=left;fontSize=10;fontColor=#666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="580" y="600" width="150" height="20" as="geometry"/></mxCell>
<mxCell id="g27" value="四、适用场景（哪里用图引擎，哪里保持 loop）" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="900" height="22" as="geometry"/></mxCell>
<mxCell id="g28" value="&lt;b&gt;✓ 用图引擎（多任务可并行）&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• 升级 Agent：批量改进点并行处理&lt;br/&gt;&amp;nbsp;&amp;nbsp;(同文件串行/异文件并行)&lt;br/&gt;• 侦察 Agent：并行评估任务&lt;br/&gt;&amp;nbsp;&amp;nbsp;(拉日志/跑指标/回归/RAG检索)&lt;br/&gt;• 主力 Agent：并行生成多个接口需求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#67C23A;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="725" width="440" height="180" as="geometry"/></mxCell>
<mxCell id="g29" value="&lt;b&gt;✗ 保持 loop（严格串行）&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• L3 流水线内部：&lt;br/&gt;&amp;nbsp;patch→review→test→build→灰度&lt;br/&gt;&amp;nbsp;每步依赖上一步产物&lt;br/&gt;• 时序约束任务：&lt;br/&gt;&amp;nbsp;先发公告再回滚&lt;br/&gt;&amp;nbsp;图引擎管并行不管时序语义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E6A23C;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="725" width="440" height="180" as="geometry"/></mxCell>
<mxCell id="g30" value="五、关键设计点（编码必读）" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="900" height="22" as="geometry"/></mxCell>
<mxCell id="g31" value="&lt;b&gt;1. 节点定义&lt;/b&gt;：DAG 节点 = {id, task(callable), depends_on[], level}，task 内部跑完整 loop&lt;br/&gt;&lt;b&gt;2. 建图规则&lt;/b&gt;：同文件/同服务 → 串行边；不同文件 → 无边(并行)；共享依赖(DTO/Utils) → 汇聚后再跑&lt;br/&gt;&lt;b&gt;3. 并发度上限&lt;/b&gt;：Nacos firefly-upgrade-concurrency（默认3），concurrent.futures.ThreadPoolExecutor 控制&lt;br/&gt;&lt;b&gt;4. 故障隔离&lt;/b&gt;：节点失败 → 局部回滚该节点；共享依赖污染 → 整体回滚整批；瞬时抖动 → 不回滚&lt;br/&gt;&lt;b&gt;5. 不引入重引擎&lt;/b&gt;：自写轻量 DAG（拓扑排序+线程池），不引入 Airflow/Temporal，单机 Compose 够用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4F9;strokeColor=#4A90D9;fontColor=#1F2329;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="900" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>