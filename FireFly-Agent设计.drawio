  <diagram name="业务主线" id="p5">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c201" value="&lt;b&gt;FireFly 业务主线 — 企业 API 接口智能生成与自运维（Happy Path 14 步）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=20;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c202" value="&lt;b&gt;业务确定：FireFly 教育买课平台（含秒杀）：课程/秒杀/订单/支付/用户域    |    输入：业务方接口需求(自然语言+字段表+SLA)    |    输出：可运行 Spring Boot 接口服务 + 线上持续自运维    |    技术栈对齐：Java 生成 Spring Boot / Python 跑 LLM+测试+评估&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c203" value="主力 Agent（Java / Spring Boot）—— 接需求→生成→发布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;fontSize=14;fontColor=#1F2328;align=center;verticalAlign=top;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="1520" height="530" as="geometry" />
        </mxCell>
        <mxCell id="c204" value="① 业务方提交接口需求&lt;br/&gt;接口名 / 所属模块 / 业务描述(自然语言) / 入参出参字段表(名·类型·必填·校验) / SLA(QPS·RT) / 是否需缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="185" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c205" value="② requirement_parser 解析需求&lt;br/&gt;自然语言+字段表 → OpenAPI 片段；模糊处反问澄清；输出强类型规格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="246" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c206" value="③ rag_search 检索&lt;br/&gt;相似接口实现(few-shot 注入) + API 设计规范(RESTful/错误码) + 历史缺陷(同类型踩坑)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="307" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c207" value="④ code_generator 生成代码&lt;br/&gt;Controller + Service + DTO + Mapper(MyBatis-Plus) + 参数校验 + Swagger 注解，符合项目脚手架" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="368" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c208" value="⑤ test_generator 生成测试&lt;br/&gt;JUnit + Mockito 单测 + 接口契约测试；覆盖率 ≥ 80% 否则阻断发布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="429" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c209" value="⑥ nacos_register 注册服务&lt;br/&gt;元数据 version / owner / limiter；心跳保活；下线自动注销" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="490" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c210" value="⑦ sentinel_rule_push 限流规则&lt;br/&gt;核心接口 QPS 1000 / 非核心 200；熔断策略；规则热更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="551" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c211" value="⑧ deploy_orchestrator 灰度发布&lt;br/&gt;5% 流量观察 10min → 50% 观察 10min → 100%；任一档异常自动回滚上一 tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="612" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c212" value="侦察 Agent（Python / FastAPI）—— 线上监控→评估→产改进点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;fontSize=14;fontColor=#1F2328;align=center;verticalAlign=top;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="685" width="1520" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c213" value="⑨ log_collector + metric_scraper 监控&lt;br/&gt;每 5min 拉日志(按 trace_id 串联、按接口聚合) + Prometheus 指标(QPS/错误率/p99/资源)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="725" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c214" value="⑩ test_runner + quality_scorer 评估&lt;br/&gt;隔离环境跑 pytest + jacoco；多维打分对比基线(成功率/通过率/质量分/p99/成本)输出 diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="786" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c215" value="⑪ improvement_finder 产改进点&lt;br/&gt;LLM 分析低分项 → 结构化输出(接口/问题/建议/优先级)；如「订单查询 p99 超 SLA，SQL 缺索引」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="847" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c216" value="升级 Agent（Python / FastAPI）—— 消费改进点→改码→灰度→回滚/全量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;fontSize=14;fontColor=#1F2328;align=center;verticalAlign=top;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="905" width="1520" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c217" value="⑫ improvement_consumer + worktree&lt;br/&gt;消费 MQ 改进点(幂等去重)；开独立 git worktree；rag_search 检索修复案例 + review 规则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="945" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c218" value="⑬ patch→review→test→build→canary&lt;br/&gt;patch_generator(LLM+AST 生成补丁) → code_reviewer(规则+LLM 双审) → 全量测试 → docker build → 灰度 5%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1006" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c219" value="⑭ 再评估→全量/回滚→写经验库&lt;br/&gt;灰度期侦察再评估：达标 → 全量上线；退化 → git revert 回滚 + 重建上一 tag；成败案例写入经验库反哺 RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1067" width="1460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c220" value="&lt;b&gt;闭环：⑭ 评估结果回流 → ⑪ 持续产新改进点 → ⑫ 升级再改  |  软升级并行：侦察发现「某类需求生成质量低」→ 升级 nacos_config_push 热更 Prompt → 灰度评估 → 回滚或全量&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=11;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c221" value="限流点（3 处）&lt;br/&gt;① 主力调 LLM：Sentinel 限流(按租户/模型，保成本)&lt;br/&gt;② 主力对外 API：Sentinel 限流(按接口重要级)&lt;br/&gt;③ 升级并发：worktree 数量限流(防资源打爆)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00ACC1;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1184" width="500" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c222" value="自进化三档&lt;br/&gt;L1 软升级：Prompt/检索/路由 → Nacos 热更 → 灰度评估 → 一键回滚(收益 90%)&lt;br/&gt;L2 策略升级：DSL 改审查/测试规则 → 影子流量验证 → 放量&lt;br/&gt;L3 代码升级：改服务源码 → 完整 CI + 人工 approve → 灰度 → 自动回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="1184" width="540" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c223" value="业务为何选它&lt;br/&gt;Java 生成 Spring Boot 技术栈天然对齐；&lt;br/&gt;能写代码+能自升级都有落点；&lt;br/&gt;RAG/限流/Nacos/自进化都真实可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1184" width="460" height="96" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Agent工具清单" id="p6">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c224" value="&lt;b&gt;FireFly 三 Agent 工具清单（MCP 化，源自 learn-claude-code s02/s19/s13）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=20;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c225" value="工具设计三原则&lt;br/&gt;① 每个工具 = handler + JSON schema(输入定义)，注册到 dispatch map，Agent 循环不变(s02：加工具只加一行 handler)&lt;br/&gt;② 工具走 MCP 协议，跨语言——Java 主力调 Python 侦察/升级的工具无感(s19：外部服务实现协议即可)&lt;br/&gt;③ 慢工具(构建/测试/灰度观察)走 Background Tasks，先回 bg_id 占位，不阻塞循环，完成后通知合并(s13)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=top;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c226" value="主力 Agent（Java）— 10 个工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#4285F4;fontSize=13;fontColor=#1F2328;align=center;verticalAlign=top;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="175" width="500" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="c227" value="侦察 Agent（Python）— 10 个工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#34A853;fontSize=13;fontColor=#1F2328;align=center;verticalAlign=top;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="175" width="500" height="1000" as="geometry" />
