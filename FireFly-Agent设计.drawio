        <mxCell id="n1077" value="编码必须遵守的规则" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1F2328;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="1520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1078" value="1. 上下文隔离：子 Agent 一律用 fresh messages[]，不继承父对话历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=11;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n1079" value="2. task 工具仅父端注册：子 Agent 不能再派子 Agent（防递归爆炸），除非显式配置 max_depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=11;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="838" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n1080" value="3. 身份重注入(s11)：子 Agent 进 WORK 阶段前检查并重注入职责 Prompt（压缩后会忘）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=11;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="876" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n1081" value="4. 慢操作不阻塞(s13)：压测/构建等超 N 秒的活走 Background Task，不阻塞父循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=11;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="914" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n1082" value="5. 失败隔离：子 Agent 异常不影响父，父收到错误摘要后决定重试或换策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=11;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="952" width="1520" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
