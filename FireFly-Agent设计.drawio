        </mxCell>
        <mxCell id="c234" value="sentinel_rule_push&lt;br/&gt;推 Sentinel 限流规则；按接口重要级分级 QPS；熔断策略；热更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
