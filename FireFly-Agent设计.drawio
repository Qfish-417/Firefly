        <mxCell id="n1041" value="两种委派模式：task 一次性子 Agent + spawn_teammate 持久队友" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1520" height="24" as="geometry" />
