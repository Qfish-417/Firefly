        <mxCell id="n1040" value="子 Agent 机制（源自乐享 s04/s09/s20）" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1F2328;fontStyle=1;" vertex="1" parent="1">
