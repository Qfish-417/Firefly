<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="WorkBuddy" version="24.0.0">
  <diagram name="总览" id="p1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="FireFly 自进化代码 Agent — 总览（业务目标 / 通信层 / 自进化闭环 / 支撑设施）" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="① 业务目标（已确定）：FireFly 教育买课平台（含秒杀）：课程/秒杀/订单/支付/用户域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1F2328;dashed=0;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;推荐场景：教育买课平台：学员买课+秒杀抢购，Agent 自动生成/运维平台接口&lt;/b&gt;&lt;br/&gt;接受业务需求 → 生成/维护代码；线上持续监控质量；自动定位缺陷并优化。三 Agent 各有用武之地。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;为什么选它&lt;/b&gt;&lt;br/&gt;“能写代码 + 能自我升级”正契合；闭环天然：产出代码→跑起来→发现退化→改自己。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=11;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;衡量指标&lt;/b&gt;&lt;br/&gt;需求交付成功率、线上缺陷率、测试通过率、p99 延迟、单次成本/token、自升级成功率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=11;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;演进路线&lt;/b&gt;&lt;br/&gt;MVP：主力+RAG出码 → 加侦察评估 → 加升级灰度 → 放开自治认领 → Level3 改源码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=11;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1220" y="130" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="② 三 Agent 通信层（必需）：同步 gRPC + 异步 MQ + 持久收件箱 + Nacos 发现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1F2328;dashed=0;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="1520" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;同步通信（gRPC）&lt;/b&gt;&lt;br/&gt;主力→侦察：实时评估打分&lt;br/&gt;主力→升级：即时修复&lt;br/&gt;强类型 protobuf，跨 Py/Java&lt;br/&gt;低延迟、强一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;异步通信（RocketMQ）&lt;/b&gt;&lt;br/&gt;侦察→升级：改进点推送&lt;br/&gt;升级→主力：新版本就绪通知&lt;br/&gt;解耦/削峰/可重试/死信队列&lt;br/&gt;补偿与重试在此" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;持久收件箱（MessageBus）&lt;/b&gt;&lt;br/&gt;每 agent 一个 .jsonl 邮箱&lt;br/&gt;append 写、drain 读&lt;br/&gt;跨重启不丢、上下文隔离&lt;br/&gt;权限冒泡：审批请求→Lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="320" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;服务发现（Nacos）&lt;/b&gt;&lt;br/&gt;三 agent 注册+心跳&lt;br/&gt;配置中心：Prompt/限流阈值热更&lt;br/&gt;灰度路由规则动态下发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="320" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;通信为何必需&lt;/b&gt;&lt;br/&gt;不通信=三个孤岛，闭环转不起来。分层：实时走 gRPC，事件走 MQ，状态走共享库，发现走 Nacos。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="320" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="③ 自进化闭环（三 Agent + 中心经验库）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1F2328;dashed=0;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1520" height="360" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;主力 Agent（Java）&lt;/b&gt;&lt;br/&gt;Spring Boot + 状态机&lt;br/&gt;对业务：任务编排/对外API&lt;br/&gt;Sentinel 限流熔断&lt;br/&gt;注册 Nacos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="640" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;侦察 Agent（Python）&lt;/b&gt;&lt;br/&gt;日志/指标聚合&lt;br/&gt;跑 pytest、质量打分&lt;br/&gt;对比基线、产出改进点&lt;br/&gt;写经验库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="640" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;升级 Agent（Python）&lt;/b&gt;&lt;br/&gt;LLM 生成补丁/AST 改写&lt;br/&gt;触发构建、灰度、回滚&lt;br/&gt;worktree 隔离每任务&lt;br/&gt;自治认领看板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="640" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;经验库（共享）&lt;/b&gt;&lt;br/&gt;向量库 + Skills&lt;br/&gt;案例库 + 任务图&lt;br/&gt;三方共享记忆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=12;fontColor=#1F2328;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1320" y="640" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="① 日志/错误/反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#1F2328;strokeColor=#1F2328;endArrow=classic;startArrow=none;" edge="1" parent="1" source="c14" target="c15">
