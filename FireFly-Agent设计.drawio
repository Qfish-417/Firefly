        </mxCell>
        <mxCell id="c102" value="三 Agent 如何用 RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1F2328;dashed=0;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1060" y="110" width="480" height="920" as="geometry" />
        </mxCell>
        <mxCell id="c103" value="&lt;b&gt;主力 Agent 用 RAG&lt;/b&gt;&lt;br/&gt;· 接需求后检索相似历史实现&lt;br/&gt;  作 few-shot 注入 Prompt&lt;br/&gt;· 检索团队编码规范/架构约定&lt;br/&gt;· 检索历史踩坑避免重蹈&lt;br/&gt;&lt;b&gt;目的&lt;/b&gt;：让生成的代码符合既有风格、少返工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="160" width="440" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c104" value="&lt;b&gt;侦察 Agent 用 RAG&lt;/b&gt;&lt;br/&gt;· 检索历史错误模式做评估对照&lt;br/&gt;· 检索已知缺陷特征匹配新日志&lt;br/&gt;· 改进点写入经验库(向量+案例)&lt;br/&gt;· 检索同类问题历史修复方案&lt;br/&gt;&lt;b&gt;目的&lt;/b&gt;：评估有据、改进点可追溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="410" width="440" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c105" value="&lt;b&gt;升级 Agent 用 RAG&lt;/b&gt;&lt;br/&gt;· 检索修复案例 + 代码上下文生成补丁&lt;br/&gt;· 检索类似改动的 review 规则做自审&lt;br/&gt;· 检索回滚案例决定 keep/remove&lt;br/&gt;· Skills 两层加载：名进 system，按需注入&lt;br/&gt;&lt;b&gt;目的&lt;/b&gt;：改得准、审得严、回得来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=11;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="660" width="440" height="230" as="geometry" />
