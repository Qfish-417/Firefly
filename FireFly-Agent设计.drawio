        <mxCell id="c228" value="升级 Agent（Python）— 12 个工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#EA4335;fontSize=13;fontColor=#1F2328;align=center;verticalAlign=top;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="175" width="500" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="c229" value="requirement_parser&lt;br/&gt;需求文档(自然语言+字段表)→OpenAPI 片段；模糊处反问澄清；输出强类型规格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="215" width="480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="c230" value="rag_search&lt;br/&gt;top-k 检索相似实现/规范/缺陷；按 repo·模块过滤；返回带引文；超时降级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="293" width="480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="c231" value="code_generator&lt;br/&gt;生成 Spring Boot 代码；符合项目脚手架；MyBatis-Plus；参数校验；Swagger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="371" width="480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="c232" value="test_generator&lt;br/&gt;JUnit+Mockito 单测 + 契约测试；覆盖率 ≥80% 否则阻断；生成边界用例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#1F2328;align=left;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="449" width="480" height="68" as="geometry" />
