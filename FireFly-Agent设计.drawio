        <mxCell id="n1075" value="灰度观察期间持续监控，触发回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;fontSize=10;fontColor=#1F2328;arcSize=8;" vertex="1" parent="1">
