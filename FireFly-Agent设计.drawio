        <mxCell id="c50" value="② 主力 Agent（Java / Spring Boot）内部模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1F2328;dashed=0;arcSize=4;" vertex="1" parent="1">
