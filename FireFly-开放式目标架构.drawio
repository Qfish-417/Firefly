  <diagram id="target-overview" name="01-目标架构总览">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="FireFly 开放式目标架构：受控的自进化业务系统" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1200" height="50" as="geometry"/></mxCell>
        <mxCell id="t2" value="核心边界：Learning Runtime 与自进化控制面分离；三个 Agent 可拆可合；教学与软件变更必须有证据、验证、审批策略和回滚路径" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="1300" height="40" as="geometry"/></mxCell>

        <mxCell id="actor" value="学习者 / 教师 / 创作者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="runtime" value="Learning Runtime&#xa;World / Mission / Attempt&#xa;Evidence / Assessment / Mastery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="admin" value="教师与治理入口&#xa;课程约束、同意、风险等级&#xa;审批、暂停、紧急停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="250" height="100" as="geometry"/></mxCell>

        <mxCell id="cp" value="自进化控制面" style="swimlane;html=1;rounded=0;horizontal=1;startSize=32;fillColor=#F7F8FA;strokeColor=#5E6C84;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="830" height="360" as="geometry"/></mxCell>
        <mxCell id="workflow" value="持久工作流 / 状态机&#xa;长任务、定时器、重试、人工等待" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="cp"><mxGeometry x="30" y="65" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="registry" value="Agent Registry&#xa;能力目录、版本、租约、健康度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="cp"><mxGeometry x="300" y="65" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="policy" value="Policy / Risk Engine&#xa;自主等级、预算、审批与阻断规则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;" vertex="1" parent="cp"><mxGeometry x="570" y="65" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="eventbus" value="事件总线 + Outbox/Inbox&#xa;至少一次投递 + 幂等消费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="cp"><mxGeometry x="30" y="210" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="artifact" value="Artifact Registry&#xa;Git / 镜像 / 报告 / 数据集&#xa;只传引用，不在消息中塞大对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;" vertex="1" parent="cp"><mxGeometry x="300" y="210" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="audit" value="审计与可观测性&#xa;Trace / 成本 / 决策 / 变更谱系" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;" vertex="1" parent="cp"><mxGeometry x="570" y="210" width="220" height="90" as="geometry"/></mxCell>

        <mxCell id="agents" value="可组合 Agent 能力面" style="swimlane;html=1;rounded=0;horizontal=1;startSize=32;fillColor=#F7F8FA;strokeColor=#5E6C84;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1210" y="140" width="510" height="500" as="geometry"/></mxCell>
        <mxCell id="mainbundle" value="Learning Director&#xa;学习旅程 / Mission 决策&#xa;用户沟通 / 协作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="agents"><mxGeometry x="35" y="65" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="scoutbundle" value="Learning Scientist&#xa;观察 / 认知诊断&#xa;学习评价 / 证据整理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="agents"><mxGeometry x="275" y="65" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="upgradebundle" value="Experience Engineer&#xa;插件 / 流程 / RAG / 代码&#xa;只提交 ChangeSet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="agents"><mxGeometry x="35" y="220" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="workers" value="平台门禁与 Workers&#xa;Reviewer / Replay / Sandbox / Release&#xa;独立权限，不是第四个 Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="agents"><mxGeometry x="275" y="220" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="kernel" value="Agent Kernel：身份、能力、工具、预算、取消、检查点、结构化输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=12;" vertex="1" parent="agents"><mxGeometry x="35" y="385" width="440" height="70" as="geometry"/></mxCell>

        <mxCell id="modelgw" value="Model Gateway（TypeScript）&#xa;pi-ai 多模型适配 + 路由 + 降级&#xa;统一 HTTP/SSE/gRPC 契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="710" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="models" value="云模型 / 本地模型 / 专用模型&#xa;按任务、质量、时延、成本、隐私路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1540" y="720" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="memory" value="知识与状态层&#xa;Postgres：事实状态&#xa;Milvus + ES：检索记忆&#xa;对象存储：证据与报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="720" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="sandbox" value="执行隔离层&#xa;Git worktree / 容器沙箱 / CI&#xa;影子流量 / 灰度 / 回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="720" width="300" height="130" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="1" source="actor" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="目标 / 学习 / 作品" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2E8B57;" edge="1" parent="1" source="actor" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="目标与审批" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="admin" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="任务 / 事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5E6C84;" edge="1" parent="1" source="cp" target="agents"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="学习事件 / 作品 / 评测 / 反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="1" source="runtime" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="受控策略 / 插件版本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="1" source="agents" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="1" source="agents" target="modelgw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;strokeColor=#7A5AF8;" edge="1" parent="1" source="modelgw" target="models"><mxGeometry relative="1" as="geometry"/></mxCell>
