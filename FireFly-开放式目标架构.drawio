        <mxCell id="ae2" value="Finding + Evidence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="agents" source="scientist" target="engineer"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="platform" value="共享平台：Model Gateway + pi-ai　|　Knowledge &amp; Memory Fabric　|　Tool Broker　|　Plugin Sandbox/Registry　|　Evaluation/Replay　|　Policy/Audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="990" width="1300" height="80" as="geometry"/></mxCell>
