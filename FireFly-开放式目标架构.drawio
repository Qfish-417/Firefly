        <mxCell id="director" value="Learning Director&#xa;运营旅程 / 选任务 / 解释 / 协作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="agents"><mxGeometry x="60" y="75" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="scientist" value="Learning Scientist&#xa;观察 / 认知诊断 / 效果与公平性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=13;fontStyle=1;" vertex="1" parent="agents"><mxGeometry x="500" y="75" width="300" height="100" as="geometry"/></mxCell>
