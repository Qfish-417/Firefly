  <diagram id="questlab-tools-plugins" name="11-工具与学习插件架构">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="QuestLab 工具与插件：五类目录用于发现，Capability/Policy/Broker 用于安全执行" style="text;html=1;align=center;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="1360" height="50" as="geometry"/></mxCell>

        <mxCell id="categories" value="五类工具目录" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="1660" height="250" as="geometry"/></mxCell>
        <mxCell id="perception" value="感知 Perception&#xa;profile / mastery / RAG / artifact&#xa;metric / learning event / multimodal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;fontStyle=1;" vertex="1" parent="categories"><mxGeometry x="30" y="70" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="action" value="执行 Action&#xa;mission.activate / hint.issue&#xa;assessment / plugin.patch / test / build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontStyle=1;" vertex="1" parent="categories"><mxGeometry x="345" y="70" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="collab" value="协作 Collaboration&#xa;teacher.handoff / task.delegate&#xa;artifact.publish / review.request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=12;fontStyle=1;" vertex="1" parent="categories"><mxGeometry x="660" y="70" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="usercomm" value="用户沟通 User Communication&#xa;clarification / feedback / progress&#xa;approval / explanation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;fontStyle=1;" vertex="1" parent="categories"><mxGeometry x="975" y="70" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="trigger" value="事件触发 Event Trigger&#xa;artifact submitted / review due&#xa;stuck learner / teacher feedback / canary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;fontStyle=1;" vertex="1" parent="categories"><mxGeometry x="1290" y="70" width="335" height="110" as="geometry"/></mxCell>

        <mxCell id="agents" value="Learning Director / Scientist / Engineer&#xa;常驻 Bootstrap：tool.search / describe / invoke / status / cancel / artifact.read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="discovery" value="Capability Discovery&#xa;任务目标 → 类别/标签/语义检索&#xa;Schema 兼容、模态、学科、可访问性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="440" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="registry" value="Tool / Plugin Registry&#xa;CapabilityDescriptor + Manifest&#xa;版本 / 健康 / SchemaHash / 签名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="440" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="policy" value="Policy Engine&#xa;Agent / Learner / Tenant / Purpose&#xa;风险、权限、同意、预算、Tool Lease" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="440" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="broker" value="Tool Broker&#xa;路由、版本固定、幂等、资源锁&#xa;Sync / Async / Stream / Cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="650" width="400" height="120" as="geometry"/></mxCell>

        <mxCell id="sync" value="Sync Providers&#xa;短查询 / Schema 校验&#xa;状态读取 / 工具发现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="850" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="async" value="Durable Async Runs&#xa;多模态 / Replay / Build / Test / Canary&#xa;operation_id + progress + checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="840" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="sandbox" value="Plugin Sandbox&#xa;Web / Container / MicroVM&#xa;network deny + resource limits + snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="840" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="remote" value="Remote Tool Providers&#xa;HTTP / gRPC / MCP Adapter&#xa;不把未知代码加载进 Agent 进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="850" width="300" height="100" as="geometry"/></mxCell>

        <mxCell id="cache" value="动态加载与 KV Cache 策略&#xa;稳定前缀只放身份、Policy、事件契约和 Bootstrap Tool；先 search 再加载 3-8 个完整 Schema；规范化排序和 JSON；任务内固定 tool/plugin snapshot；健康与价格留在 Broker，不写入 Schema；Schema/权限变化主动失效缓存；大结果只传 Artifact 引用。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=12;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="210" y="1040" width="1380" height="110" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#44546F;" edge="1" parent="1" source="agents" target="discovery"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="候选 3-8 个" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="1" source="discovery" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="授权过滤" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="1" source="registry" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Tool Lease" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="policy" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4C78A8;" edge="1" parent="1" source="broker" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="broker" target="async"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="1" source="broker" target="sandbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7A5AF8;" edge="1" parent="1" source="broker" target="remote"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
