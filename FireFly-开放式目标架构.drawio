        <mxCell id="mastery" value="Assessment &amp; Mastery&#xa;掌握 / 错误概念 / 保持 / 迁移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="experience"><mxGeometry x="180" y="300" width="260" height="70" as="geometry"/></mxCell>
