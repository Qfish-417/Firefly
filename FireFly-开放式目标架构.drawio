  <diagram id="closed-loop" name="02-受控自进化闭环">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="自进化不是“自己改自己”，而是证据驱动、风险分级、可中止的闭环" style="text;html=1;align=center;fontSize=23;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="1300" height="50" as="geometry"/></mxCell>
        <mxCell id="observe" value="1 观察 Observe&#xa;指标、日志、Trace、用户反馈&#xa;产出：Observation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="diagnose" value="2 诊断 Diagnose&#xa;基线对比、归因、复现&#xa;产出：Finding + Evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="plan" value="3 规划 Plan&#xa;候选方案、影响面、风险与预算&#xa;产出：ChangePlan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="change" value="4 变更 Change&#xa;配置 / 规则 / 源码 / 数据迁移&#xa;产出：ChangeSet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="verify" value="5 验证 Verify&#xa;静态检查、测试、仿真、影子流量&#xa;产出：VerificationReport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="170" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="release" value="6 发布 Release&#xa;审批、灰度、观测窗口、全量&#xa;产出：Release + RollbackPoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="170" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="learn" value="7 学习 Learn&#xa;结果归因、案例版本化、基线更新&#xa;成功和失败都进入经验库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="280" height="120" as="geometry"/></mxCell>

        <mxCell id="gate1" value="证据门&#xa;无复现 / 无显著性&#xa;不得进入规划" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="360" width="140" height="100" as="geometry"/></mxCell>
        <mxCell id="gate2" value="风险门&#xa;低风险自动&#xa;高风险人工审批" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="rollback" value="回滚 / 停止&#xa;指标持续退化、预算超限、策略阻断&#xa;恢复到已验证版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C9372C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="440" width="260" height="110" as="geometry"/></mxCell>

        <mxCell id="risk" value="建议重新命名风险档位，避免与库存策略 L1/L2/L3 冲突&#xa;A0：只分析　A1：配置可自动回滚　A2：规则需影子验证　A3：代码/Schema 必须审批 + CI + 灰度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="180" y="680" width="720" height="120" as="geometry"/></mxCell>
        <mxCell id="guard" value="闭环成立的最低条件&#xa;1. 客观基线与可重复评测　2. 事实状态持久化　3. 幂等事件与检查点　4. 隔离执行环境&#xa;5. 可验证回滚点　6. 全链路审计　7. 成本/次数/时间预算　8. 人工暂停与 Kill Switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5E6C84;fontSize=13;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="960" y="680" width="680" height="120" as="geometry"/></mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#44546F;strokeWidth=2;" edge="1" parent="1" source="observe" target="diagnose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#44546F;strokeWidth=2;" edge="1" parent="1" source="diagnose" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#44546F;strokeWidth=2;" edge="1" parent="1" source="plan" target="change"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#44546F;strokeWidth=2;" edge="1" parent="1" source="change" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#44546F;strokeWidth=2;" edge="1" parent="1" source="verify" target="release"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2E8B57;strokeWidth=2;" edge="1" parent="1" source="release" target="learn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="新基线 / 新案例" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2E8B57;strokeWidth=2;" edge="1" parent="1" source="learn" target="observe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="1" source="verify" target="rollback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" value="退化" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="1" source="release" target="rollback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" value="回滚结果也学习" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C9372C;" edge="1" parent="1" source="rollback" target="learn"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="composable-agents" name="03-Agent可拆可合">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="QuestLab 三 Agent：稳定能力契约 + 可替换执行单元；平台门禁保持独立" style="text;html=1;align=center;fontSize=23;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="1340" height="50" as="geometry"/></mxCell>
        <mxCell id="cap" value="逻辑能力层（先拆职责）" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F7F8FA;strokeColor=#5E6C84;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="1600" height="260" as="geometry"/></mxCell>
