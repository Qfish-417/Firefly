  <diagram id="questlab-business" name="09-QuestLab业务全景">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="FireFly QuestLab：为每个学习者生成并持续进化的项目制学习世界" style="text;html=1;align=center;fontSize=23;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="1340" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="主体业务不是卖课程，而是运营 Goal → World → Mission → Evidence → Mastery → Review 的长期学习旅程" style="text;html=1;align=center;fontSize=13;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="1280" height="35" as="geometry"/></mxCell>

