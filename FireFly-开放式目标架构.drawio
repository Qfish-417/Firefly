        <mxCell id="creator" value="内容与插件创作者&#xa;World Template / Plugin / Rubric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#7A5AF8;fontSize=13;" vertex="1" parent="users"><mxGeometry x="35" y="285" width="200" height="80" as="geometry"/></mxCell>

        <mxCell id="experience" value="学习体验层" style="swimlane;html=1;horizontal=1;startSize=32;fillColor=#F7F8FA;strokeColor=#5E6C84;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="390" y="140" width="630" height="400" as="geometry"/></mxCell>
