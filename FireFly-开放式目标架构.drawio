        <mxCell id="e5" value="Plugin Artifact&#xa;signed digest + SBOM + rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="engineerLane"><mxGeometry x="1360" y="85" width="240" height="95" as="geometry"/></mxCell>
