{
  "name": "firefly-questlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "agents/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"packages/**/*.test.ts\" \"agents/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"packages/**/*.integration.test.ts\" \"agents/**/*.integration.test.ts\"",
    "db:migrate": "node packages/persistence/src/migrate.ts",
    "admin:start": "node packages/control-plane/src/admin-server.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.0"
  }
}
